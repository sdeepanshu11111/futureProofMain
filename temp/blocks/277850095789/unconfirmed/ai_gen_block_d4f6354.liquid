{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px;
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    position: relative;
  }

  .ai-editorial-hero-{{ ai_gen_id }} {
    grid-column: span 7;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
    background-color: #f4f4f4;
  }

  .ai-editorial-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    min-height: 500px;
  }

  .ai-editorial-hero-placeholder-{{ ai_gen_id }} {
    width: 100%;
    min-height: 500px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-editorial-hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-sidebar-{{ ai_gen_id }} {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-editorial-text-block-{{ ai_gen_id }} {
    background-color: {{ block.settings.text_block_bg }};
    padding: {{ block.settings.text_block_padding }}px;
    border-radius: {{ block.settings.text_block_radius }}px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-editorial-eyebrow-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ block.settings.eyebrow_color }};
    margin: 0;
  }

  .ai-editorial-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-editorial-body-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
    color: {{ block.settings.body_color }};
  }

  .ai-editorial-body-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-editorial-body-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-editorial-cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background-color: {{ block.settings.cta_bg }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.cta_radius }}px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: 14px;
    font-weight: 500;
    transition: background-color 0.2s ease;
    align-self: flex-start;
  }

  .ai-editorial-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_bg }};
  }

  .ai-editorial-secondary-image-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
    background-color: #f4f4f4;
    aspect-ratio: 4 / 3;
  }

  .ai-editorial-secondary-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-secondary-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-secondary-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-quote-block-{{ ai_gen_id }} {
    background-color: {{ block.settings.quote_bg }};
    padding: {{ block.settings.text_block_padding }}px;
    border-radius: {{ block.settings.text_block_radius }}px;
    border-left: 4px solid {{ block.settings.quote_accent }};
  }

  .ai-editorial-quote-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.quote_size }}px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-style: italic;
  }

  .ai-editorial-quote-author-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: 14px;
    color: {{ block.settings.body_color }};
    opacity: 0.7;
  }

  @media screen and (max-width: 989px) {
    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-editorial-hero-{{ ai_gen_id }},
    .ai-editorial-sidebar-{{ ai_gen_id }} {
      grid-column: span 1;
    }

    .ai-editorial-hero-image-{{ ai_gen_id }},
    .ai-editorial-hero-placeholder-{{ ai_gen_id }} {
      min-height: 400px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-layout-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px;
    }

    .ai-editorial-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-editorial-quote-{{ ai_gen_id }} {
      font-size: {{ block.settings.quote_size | times: 0.8 }}px;
    }

    .ai-editorial-hero-image-{{ ai_gen_id }},
    .ai-editorial-hero-placeholder-{{ ai_gen_id }} {
      min-height: 300px;
    }
  }
{% endstyle %}

<editorial-layout-{{ ai_gen_id }}
  class="ai-editorial-layout-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-editorial-grid-{{ ai_gen_id }}">
    <div class="ai-editorial-hero-{{ ai_gen_id }}">
      {% if block.settings.hero_image %}
        <img
          src="{{ block.settings.hero_image | image_url: width: 1400 }}"
          alt="{{ block.settings.hero_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.hero_image.width }}"
          height="{{ block.settings.hero_image.height }}"
          class="ai-editorial-hero-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-editorial-hero-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-editorial-sidebar-{{ ai_gen_id }}">
      <div class="ai-editorial-text-block-{{ ai_gen_id }}">
        {% if block.settings.eyebrow != blank %}
          <p class="ai-editorial-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="ai-editorial-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.body_text != blank %}
          <div class="ai-editorial-body-{{ ai_gen_id }}">
            {{ block.settings.body_text }}
          </div>
        {% endif %}

        {% if block.settings.button_text != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" class="ai-editorial-cta-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}
      </div>

      {% if block.settings.show_secondary_image %}
        <div class="ai-editorial-secondary-image-{{ ai_gen_id }}">
          {% if block.settings.secondary_image %}
            <img
              src="{{ block.settings.secondary_image | image_url: width: 800 }}"
              alt="{{ block.settings.secondary_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.secondary_image.width }}"
              height="{{ block.settings.secondary_image.height }}"
            >
          {% else %}
            <div class="ai-editorial-secondary-placeholder-{{ ai_gen_id }}">
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_quote and block.settings.quote_text != blank %}
        <div class="ai-editorial-quote-block-{{ ai_gen_id }}">
          <blockquote class="ai-editorial-quote-{{ ai_gen_id }}">
            "{{ block.settings.quote_text }}"
          </blockquote>
          {% if block.settings.quote_author != blank %}
            <cite class="ai-editorial-quote-author-{{ ai_gen_id }}">— {{ block.settings.quote_author }}</cite>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</editorial-layout-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Magazine editorial",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Art of Mindful Beauty"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Discover how intentional skincare rituals can transform not just your complexion, but your entire approach to self-care and wellness.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Read the full story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Secondary image"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "secondary_image",
      "label": "Secondary image"
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "checkbox",
      "id": "show_quote",
      "label": "Show quote",
      "default": true
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote text",
      "default": "Beauty is not about perfection. It's about feeling confident in your own skin."
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote author",
      "default": "Dr. Sarah Chen, Dermatologist"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F9F9F9"
    },
    {
      "type": "color",
      "id": "text_block_bg",
      "label": "Text block background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "quote_bg",
      "label": "Quote background",
      "default": "#F3F3F4"
    },
    {
      "type": "color",
      "id": "quote_accent",
      "label": "Quote accent",
      "default": "#FF4D00"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#FF4D00"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1A1C1C"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text",
      "default": "#444748"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "Button background",
      "default": "#FF4D00"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cta_hover_bg",
      "label": "Button hover background",
      "default": "#D43F00"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "fraunces_n5"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "min": 14,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "quote_size",
      "label": "Quote size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "text_block_padding",
      "label": "Text block padding",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "text_block_radius",
      "label": "Text block border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "cta_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Magazine editorial"
    }
  ]
}
{% endschema %}
