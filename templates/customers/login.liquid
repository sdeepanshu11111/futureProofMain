{% render 'customer-styles' %}
<section class="cust">
  <div class="container cust__inner cust__narrow">
    <div style="text-align:center;margin-bottom:32px">
      <h1 class="cust__h1" style="margin-bottom:8px">Welcome back</h1>
      <p style="color:var(--c-muted);font-size:14px">Log in to track orders, manage addresses, and check out faster.</p>
    </div>
    {% form 'customer_login', class: 'cust__form' %}
      {% if form.errors %}
        <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px 16px;border-radius:var(--r-md);font-size:14px;margin-bottom:18px">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
      <div class="cust__field">
        <label for="cust-email">Email</label>
        <input type="email" name="customer[email]" id="cust-email" autocomplete="email" required>
      </div>
      <div class="cust__field">
        <label for="cust-pass" style="display:flex;justify-content:space-between;align-items:center">
          <span>Password</span>
          <a href="#recover" style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--c-accent);text-decoration:underline" onclick="document.getElementById('recover').style.display='block';return false;">Forgot?</a>
        </label>
        <input type="password" name="customer[password]" id="cust-pass" autocomplete="current-password" required>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;margin-top:8px">Log in</button>
    {% endform %}

    <div id="recover" style="display:none;margin-top:32px;padding-top:24px;border-top:1px solid var(--c-border)">
      <h2 class="cust__h2">Reset your password</h2>
      {% form 'recover_customer_password' %}
        {% if form.posted_successfully? %}
          <p style="color:var(--c-success);font-size:14px;margin-bottom:14px">Check your email — we sent you a reset link.</p>
        {% endif %}
        <div class="cust__field">
          <label for="recover-email">Email</label>
          <input type="email" name="email" id="recover-email" required>
        </div>
        <button type="submit" class="btn btn-secondary" style="width:100%">Send reset link</button>
      {% endform %}
    </div>

    <p class="cust__links">New here? <a href="{{ routes.account_register_url }}">Create an account</a></p>
  </div>
</section>
