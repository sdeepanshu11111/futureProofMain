{% render 'customer-styles' %}
<section class="cust">
  <div class="container cust__inner cust__narrow">
    <div style="text-align:center;margin-bottom:32px">
      <h1 class="cust__h1" style="margin-bottom:8px">Activate your account</h1>
      <p style="color:var(--c-muted);font-size:14px">Set a password to activate your account and start shopping.</p>
    </div>
    {% form 'activate_customer_password' %}
      {% if form.errors %}
        <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px 16px;border-radius:var(--r-md);font-size:14px;margin-bottom:18px">{{ form.errors | default_errors }}</div>
      {% endif %}
      <div class="cust__field">
        <label for="ac-pass">Password</label>
        <input type="password" name="customer[password]" id="ac-pass" autocomplete="new-password" required>
      </div>
      <div class="cust__field">
        <label for="ac-pass2">Confirm password</label>
        <input type="password" name="customer[password_confirmation]" id="ac-pass2" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%">Activate account</button>
    {% endform %}
  </div>
</section>
