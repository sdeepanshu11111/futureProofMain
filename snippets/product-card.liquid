{%- liquid
  assign img2 = product.featured_image
  if product.images.size > 1
    assign img2 = product.images[1]
  endif
  
  assign is_sold_out = false
  unless product.available
    assign is_sold_out = true
  endunless
  
  assign is_low_stock = false
  if product.available and product.selected_or_first_available_variant.inventory_management != blank and product.selected_or_first_available_variant.inventory_quantity > 0 and product.selected_or_first_available_variant.inventory_quantity <= 15
    assign is_low_stock = true
  endif
-%}

<div class="pc-new {% if is_sold_out %}pc-new--sold-out{% endif %}">
  <a href="{{ product.url }}" class="pc-new__link">
    <div class="pc-new__media">
      {%- if product.featured_image -%}
        <img class="pc-new__img pc-new__img--1" src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="350" height="350">
        {%- if img2 != product.featured_image -%}
          <img class="pc-new__img pc-new__img--2" src="{{ img2 | image_url: width: 700 }}" alt="" loading="lazy" width="350" height="350">
        {%- endif -%}
      {%- else -%}
        <div class="pc-new__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
      {%- endif -%}

      <div class="pc-new__badges-left">
        {%- if product.tags contains 'bestseller' or product.tags contains 'Best Seller' -%}
          <span class="pc-new__badge pc-new__badge--best">Bestseller</span>
        {%- endif -%}
        {%- if is_low_stock -%}
          <span class="pc-new__badge pc-new__badge--low-stock">Limited Stock</span>
        {%- endif -%}
      </div>

      <div class="pc-new__badges-right">
        <span class="pc-new__rating-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#D4A843" stroke="#D4A843" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          4.9/5 Rating
        </span>
      </div>

    </div>

    <div class="pc-new__body">
      <h3 class="pc-new__title">{{ product.title }}</h3>
      
      <div class="pc-new__price-row">
        {% render 'product-price', product: product, style: 'card' %}
      </div>
    </div>
  </a>

  <div class="pc-new__footer">
    <form action="{{ routes.cart_add_url }}" method="post" data-quick-add class="pc-new__form">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {%- if is_sold_out -%}
        <button type="button" class="pc-new__atc pc-new__atc--sold-out" disabled>Sold Out</button>
      {%- else -%}
        <button type="submit" class="pc-new__atc">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          <span>SHOP NOW</span>
        </button>
      {%- endif -%}
    </form>
    {% comment %} <div class="pc-new__trust">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      COD Available
    </div> {% endcomment %}
  </div>
</div>

{%- unless product_card_css_done -%}
<style>
.pc-new {
  background: #ffffff;
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  position: relative;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
  border: 1px solid #ECE6DD;
  height: 100%;
}
@media (min-width: 750px) {
  .pc-new { border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
}
.pc-new:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
}
.pc-new--sold-out {
  opacity: 0.65;
}
.pc-new--sold-out:hover {
  transform: none;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
}
.pc-new__link {
  color: inherit;
  display: flex;
  flex-direction: column;
  flex: 1;
  text-decoration: none;
}
.pc-new__media {
  position: relative;
  aspect-ratio: 1/1;
  overflow: hidden;
  background: #f7f5f1;
  border-radius: 14px 14px 0 0;
}
@media (min-width: 750px) {
  .pc-new__media { border-radius: 16px 16px 0 0; }
}
.pc-new__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.35s, transform 0.5s;
}
.pc-new__img--2 {
  opacity: 0;
}
.pc-new:hover .pc-new__img--1 {
  opacity: 0;
}
.pc-new:hover .pc-new__img--2 {
  opacity: 1;
}
.pc-new:hover .pc-new__img {
  transform: scale(1.04);
}
.pc-new__placeholder {
  width: 100%;
  height: 100%;
}
.pc-new__badges-left {
  position: absolute;
  top: 8px;
  left: 8px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  z-index: 2;
}
@media (min-width: 750px) {
  .pc-new__badges-left { top: 12px; left: 12px; gap: 6px; }
}
.pc-new__badge {
  font-family: var(--f-body, 'DM Sans', sans-serif);
  font-size: 9px;
  font-weight: 700;
  padding: 3px 6px;
  border-radius: 5px;
  letter-spacing: 0.08em;
  line-height: 1;
  text-transform: uppercase;
}
@media (min-width: 750px) {
  .pc-new__badge { font-size: 11px; padding: 4px 8px; border-radius: 6px; letter-spacing: 0.1em; }
}
.pc-new__badge--best {
  background: #D4A843;
  color: #fff;
}
.pc-new__badge--low-stock {
  background: #FF4D00;
  color: #fff;
}
.pc-new__badges-right {
  position: absolute;
  top: 8px;
  right: 8px;
  z-index: 2;
}
@media (min-width: 750px) {
  .pc-new__badges-right { top: 12px; right: 12px; }
}
.pc-new__rating-pill {
  background: #ffffff;
  color: #1a1c1c;
  font-family: var(--f-body, 'DM Sans', sans-serif);
  font-size: 10px;
  font-weight: 700;
  padding: 4px 8px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  gap: 3px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  white-space: nowrap;
}
.pc-new__rating-pill svg { width: 10px; height: 10px; }
@media (min-width: 750px) {
  .pc-new__rating-pill { font-size: 12px; padding: 6px 12px; gap: 4px; }
  .pc-new__rating-pill svg { width: 14px; height: 14px; }
}
.pc-new__body {
  padding: 10px 12px 8px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
}
@media (min-width: 750px) {
  .pc-new__body { padding: 16px; gap: 8px; }
}
.pc-new__title {
  font-family: var(--f-body, 'DM Sans', sans-serif);
  font-size: 13px;
  font-weight: 600;
  margin: 0;
  line-height: 1.35;
  color: #1a1c1c;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: calc(1.35em * 2);
}
@media (min-width: 750px) {
  .pc-new__title { font-size: 16px; line-height: 1.4; min-height: calc(1.4em * 2); }
}
.pc-new__price-row {
  display: flex;
  align-items: baseline;
  gap: 6px;
  flex-wrap: wrap;
  margin-top: auto;
}
.pc-new__price {
  font-family: var(--f-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 700;
  color: #1a1c1c;
  letter-spacing: -0.01em;
}
@media (min-width: 750px) {
  .pc-new__price { font-size: 20px; }
}
.pc-new__compare {
  font-family: var(--f-body, 'DM Sans', sans-serif);
  font-size: 12px;
  color: #8a8a8a;
  text-decoration: line-through;
}
@media (min-width: 750px) {
  .pc-new__compare { font-size: 14px; }
}
.pc-new__savings {
  font-family: var(--f-body, 'DM Sans', sans-serif);
  font-size: 10px;
  font-weight: 700;
  color: #FF4D00;
  background: rgba(255, 77, 0, 0.1);
  padding: 3px 5px;
  border-radius: 4px;
  line-height: 1;
}
@media (min-width: 750px) {
  .pc-new__savings { font-size: 11px; padding: 4px 6px; }
}
.pc-new__footer {
  padding: 0 12px 12px;
  margin-top: auto;
}
@media (min-width: 750px) {
  .pc-new__footer { padding: 0 16px 16px; }
}
.pc-new__form {
  margin: 0 0 6px 0;
}
@media (min-width: 750px) {
  .pc-new__form { margin: 0 0 8px 0; }
}
.pc-new__atc {
  width: 100%;
  padding: 10px 8px;
  background: #FF4D00;
  color: #ffffff;
  border: none;
  border-radius: 10px;
  font-family: var(--f-body, 'DM Sans', sans-serif);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.01em;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.1s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  line-height: 1;
  min-height: 40px;
}
.pc-new__atc svg { width: 14px; height: 14px; }
@media (min-width: 750px) {
  .pc-new__atc { padding: 12px; border-radius: 12px; font-size: 14px; min-height: 44px; }
  .pc-new__atc svg { width: 16px; height: 16px; }
}
.pc-new__atc:hover {
  background: #e64500;
}
.pc-new__atc:active {
  transform: scale(0.98);
}
.pc-new__atc--sold-out {
  background: #ECECEC;
  color: #8a8a8a;
  cursor: not-allowed;
}
.pc-new__atc--sold-out:hover {
  background: #ECECEC;
  transform: none;
}
.pc-new__trust {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  font-family: var(--f-body, 'DM Sans', sans-serif);
  font-size: 10px;
  font-weight: 600;
  color: #444748;
}
@media (min-width: 750px) {
  .pc-new__trust { font-size: 11px; }
}
.pc-new__trust svg {
  color: #22C55E;
  width: 11px;
  height: 11px;
}
</style>
{%- assign product_card_css_done = true -%}
{%- endunless -%}
