{%- if template contains 'product' and settings.show_sticky_atc -%}
<div class="sa" data-sticky-atc hidden>
  <div class="sa__inner">
    <div class="sa__left">
      {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 120 }}" alt="" class="sa__img" width="44" height="44" loading="lazy">{%- endif -%}
      <div class="sa__meta">
        <p class="sa__title">{{ product.title | truncatewords: 5 }}</p>
        <p class="sa__price">
          {% render 'product-price', product: product, style: 'sticky' %}
        </p>
      </div>
    </div>
    <button class="sa__btn" data-sa-btn type="button">BUY NOW</button>
  </div>
</div>
<style>
.sa{position:fixed;bottom:0;left:0;right:0;background:#FFFFFF;border-top:1px solid #E5E5E5;padding:8px 12px calc(8px + env(safe-area-inset-bottom));z-index:95;box-shadow:0 -10px 28px rgba(0,0,0,.08);transform:translateY(120%);transition:transform .3s cubic-bezier(.4,0,.2,1)}
.sa.is-visible{transform:translateY(0)}
.sa__inner{display:flex;align-items:center;justify-content:space-between;gap:12px}
.sa__left{display:flex;align-items:center;gap:10px;flex:1;min-width:0}
.sa__img{width:44px;height:44px;border-radius:8px;object-fit:cover;flex-shrink:0;background:#F3F4F6}
.sa__meta{min-width:0;flex:1}
.sa__title{font-size:13px;font-weight:600;margin:0 0 2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#111;font-family:var(--f-body);line-height:1.2}
.sa__price{margin:0;display:flex;align-items:baseline;gap:6px;font-size:13px;font-variant-numeric:tabular-nums}
.sa__price-now{font-weight:700;color:#111;font-size:15px}
.sa__price-was{font-size:12px;color:#9CA3AF;text-decoration:line-through;font-weight:400}
.sa__btn{padding:14px 22px;flex-shrink:0;font-size:13px;font-family:var(--f-body);font-weight:700;letter-spacing:.12em;text-transform:uppercase;background:#111;color:#FFF;border:0;border-radius:8px;cursor:pointer;transition:background .2s,transform .15s;white-space:nowrap}
.sa__btn:hover{background:#000}
.sa__btn:active{transform:scale(.98)}
@media(min-width:900px){.sa{display:none}}
@media(max-width:380px){.sa__btn{padding:13px 16px;font-size:12px;letter-spacing:.08em}.sa__img{width:40px;height:40px}}
</style>
<script>
(function(){
  var bar=document.querySelector('[data-sticky-atc]');
  if(!bar)return;
  var pdp=document.querySelector('[data-np-form]')||document.querySelector('[data-pdp-form]');
  if(!pdp)return;
  bar.removeAttribute('hidden');
  var atcBtn=pdp.querySelector('[data-atc]');
  if(atcBtn){
    var obs=new IntersectionObserver(function(e){bar.classList.toggle('is-visible',!e[0].isIntersecting)},{threshold:.05});
    obs.observe(atcBtn);
  }
  var sBtn=bar.querySelector('[data-sa-btn]');
  if(sBtn)sBtn.addEventListener('click',function(){
    if(atcBtn)atcBtn.click();
  });
  /* Sync price (and synthetic compare) with selected variant — mirrors whatever
     the variant card shows, so the same product-price snippet drives the value. */
  var saPrice=bar.querySelector('[data-sa-price]');
  var saCompare=bar.querySelector('[data-sa-compare]');
  pdp.addEventListener('change',function(e){
    if(e.target.matches('input[name="id"]')){
      var label=e.target.closest('.np__variant');
      if(!label)return;
      var priceEl=label.querySelector('.np__variant-price strong');
      var compEl=label.querySelector('.np__variant-price s');
      if(priceEl&&saPrice)saPrice.textContent=priceEl.textContent;
      if(saCompare){
        if(compEl){saCompare.textContent=compEl.textContent;saCompare.style.display='';}
        else{saCompare.style.display='none';}
      }
    }
  });
})();
</script>
{%- endif -%}
