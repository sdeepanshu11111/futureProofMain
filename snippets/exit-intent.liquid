{%- comment -%}
  Bloom · Conversion & retention system
  -----------------------------------------------------
  Welcome popup, exit-intent, mobile back-button trap,
  tab-away title flicker, idle cart reminder,
  pre-checkout retention. Tasteful, not annoying.
{%- endcomment -%}

<!-- Modal shell (single component reused for welcome / exit / pre-checkout) -->
<div class="ret" data-ret-modal hidden role="dialog" aria-modal="true" aria-labelledby="retTitle">
  <div class="ret__bg" data-ret-close></div>
  <div class="ret__panel" role="document">
    <button type="button" class="ret__close" data-ret-close aria-label="Close">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <div class="ret__media" data-ret-media hidden>
      {% if settings.welcome_popup_image != blank %}
        <img src="{{ settings.welcome_popup_image | image_url: width: 760 }}" alt="" loading="lazy" width="760" height="760">
      {% endif %}
    </div>
    <div class="ret__body">
      <p class="ret__eyebrow" data-ret-eyebrow></p>
      <h2 class="ret__title" id="retTitle" data-ret-title></h2>
      <p class="ret__sub" data-ret-sub></p>

      <div class="ret__form" data-ret-form>
        <input type="email" class="ret__input" data-ret-email placeholder="Your email address" autocomplete="email">
        <button type="button" class="btn btn--primary btn--block btn--lg" data-ret-submit>Reveal my code</button>
      </div>

      <div class="ret__reveal" data-ret-reveal hidden>
        <p class="ret__reveal-label">Use this code at checkout</p>
        <div class="ret__code-row">
          <code class="ret__code" data-ret-code>WELCOME10</code>
          <button type="button" class="ret__copy" data-ret-copy>Copy</button>
        </div>
        <a href="/collections/all" class="btn btn--primary btn--block btn--lg" data-ret-shop>Shop now →</a>
      </div>

      <p class="ret__fine">No spam, ever. Unsubscribe anytime.</p>
    </div>
  </div>
</div>

<!-- Idle reminder toast -->
<div class="ret-idle" data-idle-toast hidden role="status" aria-live="polite">
  <div class="ret-idle__icon" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
  </div>
  <div class="ret-idle__body">
    <p class="ret-idle__text" data-idle-text>You have items waiting in your cart</p>
    <p class="ret-idle__sub" data-idle-sub>Complete your order before they sell out</p>
  </div>
  <a href="{{ routes.cart_url }}" class="ret-idle__cta" data-idle-cta>View cart →</a>
  <button type="button" class="ret-idle__close" data-idle-close aria-label="Dismiss">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </button>
</div>

<style>
.ret{position:fixed;inset:0;z-index:900;display:flex;align-items:center;justify-content:center;padding:20px}
.ret[hidden]{display:none}
.ret__bg{position:absolute;inset:0;background:rgba(31,22,20,.62);backdrop-filter:blur(6px);animation:retFade .3s ease}
.ret__panel{position:relative;background:var(--c-surface);border-radius:var(--r-lg);max-width:880px;width:100%;max-height:calc(100vh - 40px);overflow:hidden auto;display:grid;grid-template-columns:1fr;box-shadow:0 30px 80px rgba(31,22,20,.25);animation:retPop .35s cubic-bezier(.2,.8,.25,1)}
.ret__panel.has-media{grid-template-columns:1fr}
@media(min-width:760px){.ret__panel.has-media{grid-template-columns:1fr 1fr;max-height:560px}}
.ret__close{position:absolute;top:14px;right:14px;width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center;background:var(--c-surface);border:1px solid var(--c-border);border-radius:50%;color:var(--c-text);cursor:pointer;z-index:2;transition:all var(--transition);padding:0}
.ret__close:hover{color:var(--c-accent);border-color:var(--c-accent);transform:rotate(90deg)}
.ret__media{display:none;background:var(--c-surface-2);position:relative;overflow:hidden}
.ret__media:not([hidden]){display:block}
@media(max-width:759px){.ret__panel.has-media .ret__media{height:200px}}
.ret__media img{width:100%;height:100%;object-fit:cover;display:block}
.ret__body{padding:48px 40px 36px;display:flex;flex-direction:column;justify-content:center}
@media(max-width:600px){.ret__body{padding:36px 24px 28px}}
.ret__eyebrow{font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--c-accent);margin:0 0 14px}
.ret__title{font-family:var(--f-display);font-size:clamp(26px,3.6vw,38px);font-weight:600;letter-spacing:-.02em;line-height:1.1;margin:0 0 14px;color:var(--c-text)}
.ret__sub{font-size:15px;line-height:1.55;color:var(--c-muted);margin:0 0 24px}
.ret__form{display:flex;flex-direction:column;gap:10px}
.ret__input{width:100%;padding:16px 18px;border:1.5px solid var(--c-border);border-radius:var(--r-md);font-family:inherit;font-size:15px;background:var(--c-bg);color:var(--c-text);transition:border-color var(--transition)}
.ret__input:focus{outline:none;border-color:var(--c-accent);background:var(--c-surface)}
.ret__reveal{animation:retFade .4s ease}
.ret__reveal-label{font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--c-muted);margin:0 0 10px;text-align:center}
.ret__code-row{display:flex;align-items:stretch;gap:8px;background:var(--c-surface-2);border:1.5px dashed var(--c-accent);border-radius:var(--r-md);padding:14px 16px;margin-bottom:16px}
.ret__code{flex:1;font-family:'Courier New',monospace;font-size:20px;font-weight:700;letter-spacing:.12em;color:var(--c-text);align-self:center;text-align:center}
.ret__copy{background:var(--c-text);color:var(--c-surface);border:0;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:opacity var(--transition)}
.ret__copy:hover{opacity:.85}
.ret__copy.is-copied{background:var(--c-success,#2D7A55)}
.ret__fine{font-size:11px;color:var(--c-muted);margin:14px 0 0;text-align:center;line-height:1.5}

/* Pre-checkout variant — dark, compact, no email field */
.ret.is-precheckout .ret__panel{max-width:480px}
.ret.is-precheckout .ret__form{display:none}
.ret.is-precheckout .ret__reveal{display:block!important}

/* Exit intent variant — stronger urgency tone */
.ret.is-exit .ret__title{color:var(--c-accent-d)}

/* Idle toast */
.ret-idle{position:fixed;left:20px;bottom:20px;right:20px;max-width:380px;background:var(--c-surface);border:1px solid var(--c-border);border-radius:var(--r-lg);padding:14px 16px 14px 14px;box-shadow:0 12px 36px rgba(31,22,20,.16);display:flex;align-items:center;gap:12px;z-index:300;animation:retSlideUp .4s cubic-bezier(.2,.8,.25,1)}
.ret-idle[hidden]{display:none}
@media(min-width:600px){.ret-idle{left:auto;bottom:30px;right:30px}}
@media(max-width:380px){.ret-idle{left:12px;right:12px;bottom:12px}}
.ret-idle__icon{flex:0 0 38px;width:38px;height:38px;border-radius:50%;background:var(--c-accent-s);color:var(--c-accent-d);display:flex;align-items:center;justify-content:center}
.ret-idle__body{flex:1;min-width:0}
.ret-idle__text{font-size:13px;font-weight:600;color:var(--c-text);margin:0;line-height:1.3}
.ret-idle__sub{font-size:11px;color:var(--c-muted);margin:2px 0 0;line-height:1.3}
.ret-idle__cta{font-size:12px;font-weight:600;color:var(--c-accent);text-decoration:none;white-space:nowrap;flex:0 0 auto}
.ret-idle__cta:hover{color:var(--c-accent-d)}
.ret-idle__close{width:24px;height:24px;border:0;background:transparent;color:var(--c-muted);cursor:pointer;display:flex;align-items:center;justify-content:center;border-radius:50%;flex:0 0 24px;padding:0;transition:background var(--transition)}
.ret-idle__close:hover{background:var(--c-bg);color:var(--c-text)}

@keyframes retFade{from{opacity:0}to{opacity:1}}
@keyframes retPop{from{opacity:0;transform:translateY(20px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes retSlideUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
</style>

<script>
(function(){
  'use strict';
  var R = (window.theme && window.theme.retention) || {};
  var T = (window.theme && window.theme.template) || '';
  var STORAGE = {
    welcomeShown: 'bloom_welcome_v1',
    exitShown:    'bloom_exit_v1',
    precheckShown:'bloom_precheck_v1',
    idleDismissed:'bloom_idle_v1'
  };

  // Pages where retention popups should NOT fire (customer flows, cart page, password)
  var SUPPRESS_TEMPLATES = ['cart','password','customers/login','customers/register','customers/account','customers/addresses','customers/order','customers/reset_password','customers/activate_account'];
  var suppressed = SUPPRESS_TEMPLATES.some(function(t){return T === t || T.indexOf(t) === 0});

  // ---- DOM helpers ----
  var modal = document.querySelector('[data-ret-modal]');
  var idleToast = document.querySelector('[data-idle-toast]');
  if(!modal) return;
  var $ = function(s,c){return (c||modal).querySelector(s)};
  function getDayKey(){var d=new Date();return d.getFullYear()+'-'+d.getMonth()+'-'+d.getDate()}
  function lsGet(k){try{return localStorage.getItem(k)}catch(e){return null}}
  function lsSet(k,v){try{localStorage.setItem(k,v)}catch(e){}}
  function ssGet(k){try{return sessionStorage.getItem(k)}catch(e){return null}}
  function ssSet(k,v){try{sessionStorage.setItem(k,v)}catch(e){}}

  // ---- Modal show/hide ----
  var afterCloseCb = null;
  function showModal(opts){
    modal.className = 'ret ' + (opts.variant ? 'is-'+opts.variant : '');
    var panel = $('.ret__panel');
    var media = $('[data-ret-media]');
    var hasImg = media && media.querySelector('img');
    if(opts.showMedia && hasImg){
      panel.classList.add('has-media');
      media.removeAttribute('hidden');
    } else {
      panel.classList.remove('has-media');
      media.setAttribute('hidden','');
    }
    $('[data-ret-eyebrow]').textContent = opts.eyebrow || '';
    $('[data-ret-eyebrow]').style.display = opts.eyebrow ? '' : 'none';
    $('[data-ret-title]').textContent = opts.title || '';
    $('[data-ret-sub]').textContent = opts.sub || '';
    $('[data-ret-code]').textContent = opts.code || '';
    if(opts.submitText) $('[data-ret-submit]').textContent = opts.submitText;

    // Reset reveal vs form
    if(opts.skipForm){
      $('[data-ret-form]').style.display = 'none';
      $('[data-ret-reveal]').removeAttribute('hidden');
    } else {
      $('[data-ret-form]').style.display = '';
      $('[data-ret-reveal]').setAttribute('hidden','');
      var emailInput = $('[data-ret-email]');
      if(emailInput) emailInput.value = '';
    }
    // Shop CTA destination
    if(opts.shopHref) $('[data-ret-shop]').setAttribute('href', opts.shopHref);

    afterCloseCb = opts.onClose || null;
    modal.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
  }
  function hideModal(){
    modal.setAttribute('hidden','');
    document.body.style.overflow = '';
    if(typeof afterCloseCb === 'function'){var cb=afterCloseCb;afterCloseCb=null;cb()}
  }
  document.querySelectorAll('[data-ret-close]').forEach(function(b){b.addEventListener('click',hideModal)});
  document.addEventListener('keydown',function(e){if(e.key==='Escape' && !modal.hasAttribute('hidden'))hideModal()});

  // ---- Submit (reveal code) ----
  $('[data-ret-submit]').addEventListener('click',function(){
    var input = $('[data-ret-email]');
    var email = input ? input.value.trim() : '';
    if(!email || email.indexOf('@') < 1){
      if(input){input.style.borderColor='var(--c-urgent,#C84A3F)';input.focus()}
      return;
    }
    // Persist email locally so other parts of the theme can use it
    lsSet('bloom_lead_email', email);
    // Submit asynchronously to Shopify customer endpoint (no-op on failure — UX continues)
    try {
      var fd = new FormData();
      fd.append('form_type','customer');
      fd.append('utf8','✓');
      fd.append('contact[tags]','newsletter,exit-intent-lead');
      fd.append('contact[email]',email);
      fetch('/contact#contact_form',{method:'POST',body:fd}).catch(function(){});
    } catch(e){}
    $('[data-ret-form]').style.display='none';
    $('[data-ret-reveal]').removeAttribute('hidden');
  });

  // ---- Copy code ----
  $('[data-ret-copy]').addEventListener('click',function(){
    var btn = this;
    var code = $('[data-ret-code]').textContent.trim();
    var done = function(){btn.classList.add('is-copied');btn.textContent='✓ Copied';setTimeout(function(){btn.classList.remove('is-copied');btn.textContent='Copy'},2000)};
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(code).then(done).catch(function(){
        var ta=document.createElement('textarea');ta.value=code;document.body.appendChild(ta);ta.select();try{document.execCommand('copy')}catch(e){}ta.remove();done();
      });
    } else {
      var ta=document.createElement('textarea');ta.value=code;document.body.appendChild(ta);ta.select();try{document.execCommand('copy')}catch(e){}ta.remove();done();
    }
  });

  // ---- Auto-apply discount on shop CTA ----
  $('[data-ret-shop]').addEventListener('click',function(e){
    var code = $('[data-ret-code]').textContent.trim();
    if(code){
      // Persist for cart-drawer / cart page to pick up
      lsSet('bloom_active_discount', code);
      // Add discount param so Shopify auto-applies on add-to-cart later
      var href = this.getAttribute('href') || '/collections/all';
      var sep = href.indexOf('?') > -1 ? '&' : '?';
      this.setAttribute('href', href + sep + 'discount=' + encodeURIComponent(code));
    }
  });

  // ===========================================
  // 1. WELCOME POPUP — first-time visitors
  // ===========================================
  function maybeShowWelcome(){
    if(suppressed) return;
    if(!R.welcomeEnable) return;
    if(lsGet(STORAGE.welcomeShown)) return;
    if(ssGet(STORAGE.exitShown) || ssGet(STORAGE.precheckShown)) return;
    var delay = (parseInt(R.welcomeDelay,10) || 8) * 1000;
    setTimeout(function(){
      if(!modal.hasAttribute('hidden')) return; // don't stack
      lsSet(STORAGE.welcomeShown, getDayKey());
      showModal({
        variant:'welcome',
        showMedia:true,
        eyebrow: {{ settings.welcome_popup_eyebrow|default:'WELCOME, BEAUTIFUL'|json }},
        title:   {{ settings.welcome_popup_heading|default:'10% off your first order'|json }},
        sub:     {{ settings.welcome_popup_subheading|default:'Plus skincare tips delivered to your inbox.'|json }},
        code:    R.welcomeCode || 'WELCOME10',
        submitText: {{ settings.welcome_popup_button|default:'Reveal my code'|json }},
        shopHref:'/collections/all'
      });
    }, delay);
  }

  // ===========================================
  // 2. EXIT INTENT — desktop mouse-leave + mobile back-button trap
  // ===========================================
  var exitArmed = R.exitEnable && !suppressed && !ssGet(STORAGE.exitShown);
  function fireExit(){
    if(!exitArmed) return;
    if(!modal.hasAttribute('hidden')) return;
    exitArmed = false;
    ssSet(STORAGE.exitShown, '1');
    showModal({
      variant:'exit',
      showMedia:false,
      eyebrow:'WAIT — BEFORE YOU GO',
      title: {{ settings.exit_intent_heading|default:'Wait — dont leave empty-handed'|json }},
      sub:   {{ settings.exit_intent_subheading|default:'Take 15% off if you order in the next 10 minutes.'|json }},
      code:  R.exitCode || 'DONTGO15',
      submitText:'Claim my discount',
      shopHref:'/collections/all'
    });
  }
  // Desktop: mouse leaves through the top of viewport
  function isLikelyMobile(){return window.matchMedia && window.matchMedia('(pointer:coarse)').matches}
  if(exitArmed && !isLikelyMobile()){
    var triggerCount = 0;
    document.addEventListener('mouseout', function(e){
      if(!exitArmed) return;
      if(e.relatedTarget) return; // moved to another element, not out
      if(e.clientY > 8) return;   // not near the top
      triggerCount++;
      if(triggerCount >= 1) fireExit();
    });
  }
  // Mobile: back-button trap. Insert a sentinel state so first 'back' is intercepted.
  if(exitArmed && isLikelyMobile()){
    try { history.pushState({bloomRetention:true}, '', location.href); } catch(e){}
    window.addEventListener('popstate', function(){
      if(!exitArmed) return;
      // Re-push so that closing the modal puts them back on the page
      try { history.pushState({bloomRetention:true}, '', location.href); } catch(e){}
      fireExit();
    });
  }

  // ===========================================
  // 3. TAB-AWAY TITLE FLICKER
  // ===========================================
  if(R.tabAwayEnable){
    var origTitle = document.title;
    var msg1 = R.tabAwayMsg1 || '👀 Your cart is waiting…';
    var msg2 = R.tabAwayMsg2 || '💖 Don\'t lose your items!';
    var flickerTimer = null;
    function startFlicker(){
      if(flickerTimer) return;
      var i = 0;
      flickerTimer = setInterval(function(){
        document.title = (i % 2 === 0) ? msg1 : msg2;
        i++;
      }, 1600);
    }
    function stopFlicker(){
      if(flickerTimer){clearInterval(flickerTimer);flickerTimer=null}
      document.title = origTitle;
    }
    document.addEventListener('visibilitychange', function(){
      // Only flicker if cart has items
      var hasItems = ((window.theme && window.theme.cartCount) || 0) > 0;
      // Re-check via fetch to be sure (cheap)
      if(document.hidden && hasItems){
        startFlicker();
      } else if(document.hidden){
        // Last-chance check if cart count was stale
        try {
          fetch('/cart.js',{credentials:'same-origin'}).then(function(r){return r.json()}).then(function(c){
            if(c && c.item_count > 0 && document.hidden) startFlicker();
          }).catch(function(){});
        } catch(e){}
      } else {
        stopFlicker();
      }
    });
  }

  // ===========================================
  // 4. IDLE CART REMINDER — floating toast after N seconds idle with items in cart
  // ===========================================
  if(R.idleEnable && idleToast && !suppressed){
    var idleSeconds = parseInt(R.idleSeconds,10) || 60;
    var idleTimer = null;
    var idleShown = false;
    function resetIdle(){
      if(idleShown) return;
      if(idleTimer) clearTimeout(idleTimer);
      if(ssGet(STORAGE.idleDismissed)) return;
      idleTimer = setTimeout(function(){
        // Check cart again at trigger time
        try {
          fetch('/cart.js',{credentials:'same-origin'}).then(function(r){return r.json()}).then(function(c){
            if(c && c.item_count > 0 && !idleShown && !ssGet(STORAGE.idleDismissed)){
              var textEl = idleToast.querySelector('[data-idle-text]');
              if(textEl) textEl.textContent = (R.idleText || 'You have items waiting in your cart');
              idleToast.removeAttribute('hidden');
              idleShown = true;
            }
          }).catch(function(){});
        } catch(e){}
      }, idleSeconds * 1000);
    }
    ['mousemove','keydown','scroll','touchstart','click'].forEach(function(evt){
      document.addEventListener(evt, resetIdle, {passive:true});
    });
    var idleClose = idleToast.querySelector('[data-idle-close]');
    if(idleClose){
      idleClose.addEventListener('click', function(){
        idleToast.setAttribute('hidden','');
        ssSet(STORAGE.idleDismissed, '1');
      });
    }
    resetIdle();
  }

  // ===========================================
  // 5. PRE-CHECKOUT RETENTION
  // Intercept clicks on checkout buttons in cart drawer & cart page once per session.
  // ===========================================
  if(R.precheckoutEnable){
    function attachPrecheck(el){
      if(!el || el.dataset.preBound === '1') return;
      el.dataset.preBound = '1';
      el.addEventListener('click', function(e){
        if(ssGet(STORAGE.precheckShown)) return; // shown already this session — proceed normally
        e.preventDefault();
        e.stopPropagation();
        ssSet(STORAGE.precheckShown,'1');
        var href = el.getAttribute('href') || '/checkout';
        // For form buttons the form will need to be submitted on continue
        var form = el.tagName === 'BUTTON' ? el.closest('form') : null;
        showModal({
          variant:'precheckout',
          showMedia:false,
          skipForm:true,
          eyebrow: {{ settings.precheckout_eyebrow|default:'ONE LAST THING'|json }},
          title:   {{ settings.precheckout_heading|default:'Use code SAVE5 for ₹50 off'|json }},
          sub:     {{ settings.precheckout_subheading|default:'Apply this code at checkout. Limited to your first order.'|json }},
          code:    R.precheckoutCode || 'SAVE5',
          shopHref: href,
          onClose: function(){
            // If user closes modal, take them to checkout anyway (already ssSet)
          }
        });
        // Override Shop CTA to actually proceed (form submit OR navigate)
        var shopBtn = document.querySelector('[data-ret-shop]');
        if(shopBtn){
          shopBtn.textContent = ({{ settings.precheckout_button|default:'Continue to checkout'|json }}) + ' →';
          shopBtn.onclick = function(ev){
            ev.preventDefault();
            // Save code for cart layer to read
            lsSet('bloom_active_discount', R.precheckoutCode || 'SAVE5');
            if(form){
              // Submit the cart form so cart updates, then go to checkout
              try { form.submit(); } catch(e){ window.location.href = '/checkout'; }
            } else {
              window.location.href = href;
            }
          };
        }
      });
    }
    // Bind any checkout-trigger buttons present on load + future ones (cart drawer rerenders)
    function rebind(){
      document.querySelectorAll('[data-checkout-trigger]').forEach(attachPrecheck);
    }
    rebind();
    document.addEventListener('cart:updated', rebind);
    // Watch the cart drawer for re-renders (it rebuilds its DOM on cart change)
    var drawer = document.querySelector('[data-cart-drawer]');
    if(drawer && window.MutationObserver){
      new MutationObserver(rebind).observe(drawer, {childList:true, subtree:true});
    }
  }

  // ===========================================
  // KICK OFF
  // ===========================================
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', maybeShowWelcome);
  } else {
    maybeShowWelcome();
  }
})();
</script>
