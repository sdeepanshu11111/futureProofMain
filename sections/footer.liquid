{%- liquid
  assign ig = section.settings.instagram_handle | remove: '@' | strip
  assign wa = section.settings.whatsapp_number | strip
  assign year = 'now' | date: '%Y'
  assign brand_name = settings.brand_name | default: shop.name | default: 'Shop'
  assign brand_logo = settings.logo
  if brand_logo == blank and shop.brand.logo != blank
    assign brand_logo = shop.brand.logo
  endif
-%}

<footer class="ftr" style="background:{{ section.settings.bg_color | default: '#1A1A1A' }};color:{{ section.settings.text_color | default: '#F5F1EB' }}">
  <div class="pw">

    <div class="ftr__cols">

      {%- comment -%} Column 1 — Brand {%- endcomment -%}
      <div class="ftr__col ftr__col--brand">
        <a href="{{ routes.root_url }}" class="ftr__logo" aria-label="{{ brand_name | escape }}">
          {%- if brand_logo != blank -%}
            <img src="{{ brand_logo | image_url: width: 360 }}" alt="{{ brand_name | escape }}" width="280" height="80" style="max-width:140px;height:auto;display:block">
          {%- else -%}
            {{ brand_name }}
          {%- endif -%}
        </a>
        <p class="ftr__tagline">{{ section.settings.tagline | default: "Skincare, body, and wellness for the version of you that's coming next." }}</p>
      </div>

      {%- comment -%} Column 2 — Shop {%- endcomment -%}
      <details class="ftr__col ftr__acc">
        <summary class="ftr__hd">Shop<span class="ftr__chev" aria-hidden="true"></span></summary>
        <ul class="ftr__links">
          <li><a href="/collections/skincare">Skincare</a></li>
          <li><a href="/collections/body">Body</a></li>
          <li><a href="/collections/wellness">Wellness</a></li>
          <li><a href="/collections/for-him">For Him</a></li>
          <li><a href="/collections/for-her">For Her</a></li>
          <li><a href="/collections/bundles">Bundles</a></li>
        </ul>
      </details>

      {%- comment -%} Column 3 — Help {%- endcomment -%}
      <details class="ftr__col ftr__acc">
        <summary class="ftr__hd">Help<span class="ftr__chev" aria-hidden="true"></span></summary>
        <ul class="ftr__links">
          <li><a href="/pages/shipping-policy">Shipping Policy</a></li>
          <li><a href="/pages/return-refund-policy">Return &amp; Refund Policy</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/track-order">Track order</a></li>
        </ul>
      </details>

      {%- comment -%} Column 4 — Stay in touch {%- endcomment -%}
      <div class="ftr__col ftr__col--connect">
        <h3 class="ftr__hd">Stay in touch</h3>

        {%- form 'customer', class: 'ftr__nl' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="FooterEmail" class="visually-hidden">Email</label>
          <div class="ftr__nl-row">
            <input id="FooterEmail" type="email" name="contact[email]" placeholder="Your email" required autocomplete="email">
            <button type="submit" aria-label="Subscribe">→</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="ftr__nl-msg">Thanks — you're in.</p>
          {%- elsif form.errors -%}
            <p class="ftr__nl-msg ftr__nl-msg--err">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {%- endform -%}

        <ul class="ftr__social">
          {%- if ig != blank -%}
          <li>
            <a href="https://instagram.com/{{ ig }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
              <span>@{{ ig }}</span>
            </a>
          </li>
          {%- endif -%}
          {%- if wa != blank -%}
          <li>
            <a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener" aria-label="WhatsApp">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.7 7.2L3 21l2.3-5.3A8.4 8.4 0 1 1 21 11.5z"/></svg>
              <span>{{ wa }}</span>
            </a>
          </li>
          {%- endif -%}
        </ul>
      </div>

    </div>

    <div class="ftr__bottom">
      <p class="ftr__copy">© {{ year }} {{ brand_name }}. All rights reserved.</p>
      <ul class="ftr__pmt" aria-label="Accepted payment methods">
        <li><img src="{{ 'pay-visa.svg' | asset_url }}" alt="Visa" width="40" height="24" loading="lazy"></li>
        <li><img src="{{ 'pay-mastercard.svg' | asset_url }}" alt="Mastercard" width="32" height="24" loading="lazy"></li>
        <li><img src="{{ 'pay-rupay.svg' | asset_url }}" alt="RuPay" width="48" height="24" loading="lazy"></li>
        <li><img src="{{ 'pay-upi.svg' | asset_url }}" alt="UPI" width="44" height="24" loading="lazy"></li>
        <li><img src="{{ 'pay-paytm.svg' | asset_url }}" alt="Paytm" width="48" height="24" loading="lazy"></li>
      </ul>
    </div>

  </div>
</footer>

<style>
.ftr{padding:32px 0 20px}
@media(min-width:768px){.ftr{padding:72px 0 28px}}

.ftr__cols{display:flex;flex-direction:column;gap:0;padding-bottom:20px;border-bottom:1px solid rgba(245,241,235,.12)}
@media(min-width:600px){.ftr__cols{display:grid;grid-template-columns:1fr 1fr;gap:36px 28px;padding-bottom:40px}}
@media(min-width:990px){.ftr__cols{grid-template-columns:1.4fr 1fr 1fr 1.4fr;gap:48px}}

.ftr__col--brand{padding:0 0 20px}
@media(min-width:600px){.ftr__col--brand{grid-column:1/-1;padding:0}}
@media(min-width:990px){.ftr__col--brand{grid-column:auto}}

.ftr__logo{display:inline-block;font-family:var(--f-display);font-size:20px;font-weight:500;letter-spacing:-.02em;color:inherit;text-decoration:none;margin-bottom:8px}
.ftr__tagline{font-size:13px;line-height:1.55;margin:0;max-width:340px;opacity:.8}
@media(min-width:768px){.ftr__logo{font-size:18px;margin-bottom:14px}.ftr__tagline{font-size:14px}}

.ftr__hd{font-family:var(--f-body);font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;margin:0;color:inherit;opacity:.95;cursor:pointer;list-style:none;padding:16px 0;display:flex;align-items:center;justify-content:space-between}
.ftr__hd::-webkit-details-marker{display:none}
@media(min-width:600px){.ftr__hd{cursor:default;padding:0;margin:0 0 18px;font-size:12px;letter-spacing:.18em;opacity:.7}}

.ftr__chev{width:10px;height:10px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg);transition:transform .2s ease;opacity:.7;margin-top:-3px}
.ftr__acc[open] .ftr__chev{transform:rotate(-135deg);margin-top:3px}
@media(min-width:600px){.ftr__chev{display:none}}

.ftr__acc{border-bottom:1px solid rgba(245,241,235,.10)}
.ftr__acc:last-of-type{border-bottom:0}
@media(min-width:600px){.ftr__acc{border-bottom:0}}

.ftr__links{list-style:none;padding:0 0 16px;margin:0;display:flex;flex-direction:column;gap:12px}
@media(min-width:600px){.ftr__links{padding:0;gap:10px}}
.ftr__links a{font-size:14px;color:inherit;text-decoration:none;opacity:.85;transition:opacity var(--transition)}
.ftr__links a:hover{opacity:1;text-decoration:underline;text-underline-offset:3px}

.ftr__col--connect{padding-top:20px}
@media(min-width:600px){.ftr__col--connect{padding-top:0}}

.ftr__nl{margin:0 0 16px}
@media(min-width:768px){.ftr__nl{margin:0 0 20px}}
.ftr__nl-row{display:flex;align-items:stretch;border-bottom:1px solid rgba(245,241,235,.4);transition:border-color var(--transition)}
.ftr__nl-row:focus-within{border-color:currentColor}
.ftr__nl-row input{flex:1;background:transparent;border:0;padding:10px 0;font-family:var(--f-body);font-size:14px;color:inherit;outline:none}
.ftr__nl-row input::placeholder{color:inherit;opacity:.55}
.ftr__nl-row button{background:transparent;border:0;color:inherit;cursor:pointer;font-size:18px;padding:0 4px 0 12px;line-height:1}
.ftr__nl-msg{font-size:12px;margin:8px 0 0;opacity:.85}
.ftr__nl-msg--err{opacity:1;color:#ffb4ad}

.ftr__social{list-style:none;padding:0;margin:0;display:flex;flex-direction:row;flex-wrap:wrap;gap:18px}
@media(min-width:768px){.ftr__social{flex-direction:column;gap:10px}}
.ftr__social a{display:inline-flex;align-items:center;gap:8px;color:inherit;text-decoration:none;font-size:13px;opacity:.85;transition:opacity var(--transition)}
.ftr__social a:hover{opacity:1}

.ftr__bottom{display:flex;flex-direction:column-reverse;align-items:center;gap:14px;padding-top:18px}
@media(min-width:768px){.ftr__bottom{flex-direction:row;justify-content:space-between;gap:24px;padding-top:24px}}
.ftr__copy{font-size:11px;margin:0;opacity:.65;text-align:center}
@media(min-width:768px){.ftr__copy{font-size:12px;opacity:.75}}
.ftr__pmt{list-style:none;padding:0;margin:0;display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:center}
.ftr__pmt li{display:inline-flex;align-items:center;justify-content:center;background:#fff;padding:6px 10px;border-radius:6px;height:32px;box-sizing:border-box}
.ftr__pmt img{display:block;height:20px;width:auto}
</style>

{% schema %}
{"name":"Footer","settings":[
  {"type":"color","id":"bg_color","label":"Background","default":"#1A1A1A"},
  {"type":"color","id":"text_color","label":"Text","default":"#F5F1EB"},
  {"type":"textarea","id":"tagline","label":"Brand tagline","default":"Skincare, body, and wellness for the version of you that's coming next."},
  {"type":"text","id":"instagram_handle","label":"Instagram handle (no @)","default":"futureproof.co.in"},
  {"type":"text","id":"whatsapp_number","label":"WhatsApp number (digits only, e.g. 919999999999)"}
],"enabled_on":{"groups":["footer"]}}
{% endschema %}
