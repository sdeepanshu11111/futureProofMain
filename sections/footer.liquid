{%- liquid
  assign ig = section.settings.instagram_handle | default: '[REAL_HANDLE_PLACEHOLDER]'
  assign wa = section.settings.whatsapp_number | default: '[REAL_NUMBER_PLACEHOLDER]'
  assign year = 'now' | date: '%Y'
-%}

<footer class="ftr" style="background:{{ section.settings.bg_color | default: '#1A1A1A' }};color:{{ section.settings.text_color | default: '#F5F1EB' }}">
  <div class="pw">

    <div class="ftr__cols">

      {%- comment -%} Column 1 — Brand {%- endcomment -%}
      <div class="ftr__col ftr__col--brand">
        <a href="{{ routes.root_url }}" class="ftr__logo">FutureProof</a>
        <p class="ftr__tagline">{{ section.settings.tagline | default: "Skincare, body, and wellness for the version of you that's coming next." }}</p>
      </div>

      {%- comment -%} Column 2 — Shop {%- endcomment -%}
      <div class="ftr__col">
        <h3 class="ftr__hd">Shop</h3>
        <ul class="ftr__links">
          <li><a href="/collections/skincare">Skincare</a></li>
          <li><a href="/collections/body">Body</a></li>
          <li><a href="/collections/wellness">Wellness</a></li>
          <li><a href="/collections/for-him">For Him</a></li>
          <li><a href="/collections/for-her">For Her</a></li>
          <li><a href="/collections/bundles">Bundles</a></li>
        </ul>
      </div>

      {%- comment -%} Column 3 — Help {%- endcomment -%}
      <div class="ftr__col">
        <h3 class="ftr__hd">Help</h3>
        <ul class="ftr__links">
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="/policies/shipping-policy">Shipping policy</a></li>
          <li><a href="/policies/refund-policy">Refund policy</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/track-order">Track order</a></li>
        </ul>
      </div>

      {%- comment -%} Column 4 — Stay in touch {%- endcomment -%}
      <div class="ftr__col ftr__col--connect">
        <h3 class="ftr__hd">Stay in touch</h3>

        {%- form 'customer', class: 'ftr__nl' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="FooterEmail" class="visually-hidden">Email</label>
          <div class="ftr__nl-row">
            <input id="FooterEmail" type="email" name="contact[email]" placeholder="Your email" required autocomplete="email">
            <button type="submit" aria-label="Subscribe">→</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="ftr__nl-msg">Thanks — you're in.</p>
          {%- elsif form.errors -%}
            <p class="ftr__nl-msg ftr__nl-msg--err">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {%- endform -%}

        <ul class="ftr__social">
          <li>
            <a href="https://instagram.com/{{ ig }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
              <span>@{{ ig }}</span>
            </a>
          </li>
          <li>
            <a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener" aria-label="WhatsApp">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.7 7.2L3 21l2.3-5.3A8.4 8.4 0 1 1 21 11.5z"/></svg>
              <span>{{ wa }}</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="ftr__bottom">
      <p class="ftr__copy">© {{ year }} FutureProof. All rights reserved.</p>
      <ul class="ftr__pmt" aria-label="Accepted payment methods">
        <li><svg width="40" height="14" viewBox="0 0 40 14" aria-label="Visa"><text x="0" y="11" font-family="Arial, sans-serif" font-weight="900" font-style="italic" font-size="13" fill="#1A1F71">VISA</text></svg></li>
        <li><svg width="30" height="18" viewBox="0 0 30 18" aria-label="Mastercard"><circle cx="11" cy="9" r="7" fill="#EB001B"/><circle cx="19" cy="9" r="7" fill="#F79E1B" fill-opacity=".9"/></svg></li>
        <li><svg width="48" height="14" viewBox="0 0 48 14" aria-label="RuPay"><text x="0" y="11" font-family="Arial, sans-serif" font-weight="800" font-size="11" fill="#097B40">Ru</text><text x="14" y="11" font-family="Arial, sans-serif" font-weight="800" font-size="11" fill="#FF6633">Pay</text><polygon points="33,2 38,7 33,12" fill="#FF6633"/></svg></li>
        <li><svg width="32" height="14" viewBox="0 0 32 14" aria-label="UPI"><text x="0" y="11" font-family="Arial, sans-serif" font-weight="800" font-style="italic" font-size="11" fill="#097B40">U</text><text x="9" y="11" font-family="Arial, sans-serif" font-weight="800" font-style="italic" font-size="11" fill="#FF6633">P</text><text x="18" y="11" font-family="Arial, sans-serif" font-weight="800" font-style="italic" font-size="11" fill="#097B40">I</text></svg></li>
        <li><svg width="44" height="14" viewBox="0 0 44 14" aria-label="Paytm"><text x="0" y="11" font-family="Arial, sans-serif" font-weight="800" font-size="11" fill="#00BAF2">pay</text><text x="18" y="11" font-family="Arial, sans-serif" font-weight="800" font-size="11" fill="#002970">tm</text></svg></li>
      </ul>
    </div>

  </div>
</footer>

<style>
.ftr{padding:56px 0 24px}
@media(min-width:768px){.ftr{padding:72px 0 28px}}

.ftr__cols{display:grid;grid-template-columns:1fr;gap:36px;padding-bottom:40px;border-bottom:1px solid rgba(245,241,235,.15)}
@media(min-width:600px){.ftr__cols{grid-template-columns:1fr 1fr;gap:36px 28px}}
@media(min-width:990px){.ftr__cols{grid-template-columns:1.4fr 1fr 1fr 1.4fr;gap:48px}}

.ftr__col--brand{grid-column:1/-1}
@media(min-width:990px){.ftr__col--brand{grid-column:auto}}

.ftr__logo{display:inline-block;font-family:var(--f-display);font-size:18px;font-weight:500;letter-spacing:-.02em;color:inherit;text-decoration:none;margin-bottom:14px}
.ftr__tagline{font-size:14px;line-height:1.55;margin:0;max-width:300px;opacity:.85}

.ftr__hd{font-family:var(--f-body);font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;margin:0 0 18px;color:inherit;opacity:.7}
.ftr__links{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px}
.ftr__links a{font-size:14px;color:inherit;text-decoration:none;opacity:.9;transition:opacity var(--transition)}
.ftr__links a:hover{opacity:1;text-decoration:underline;text-underline-offset:3px}

.ftr__nl{margin:0 0 20px}
.ftr__nl-row{display:flex;align-items:stretch;border-bottom:1px solid rgba(245,241,235,.4);transition:border-color var(--transition)}
.ftr__nl-row:focus-within{border-color:currentColor}
.ftr__nl-row input{flex:1;background:transparent;border:0;padding:10px 0;font-family:var(--f-body);font-size:14px;color:inherit;outline:none}
.ftr__nl-row input::placeholder{color:inherit;opacity:.55}
.ftr__nl-row button{background:transparent;border:0;color:inherit;cursor:pointer;font-size:18px;padding:0 4px 0 12px;line-height:1}
.ftr__nl-msg{font-size:12px;margin:8px 0 0;opacity:.85}
.ftr__nl-msg--err{opacity:1;color:#ffb4ad}

.ftr__social{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px}
.ftr__social a{display:inline-flex;align-items:center;gap:10px;color:inherit;text-decoration:none;font-size:13px;opacity:.85;transition:opacity var(--transition)}
.ftr__social a:hover{opacity:1}

.ftr__bottom{display:flex;flex-direction:column;align-items:center;gap:14px;padding-top:24px}
@media(min-width:768px){.ftr__bottom{flex-direction:row;justify-content:space-between;gap:24px}}
.ftr__copy{font-size:12px;margin:0;opacity:.75}
.ftr__pmt{list-style:none;padding:0;margin:0;display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:center}
.ftr__pmt li{display:inline-flex;align-items:center;justify-content:center;background:#fff;padding:5px 8px;border-radius:4px}
.ftr__pmt svg{display:block;height:14px;width:auto}
</style>

{% schema %}
{"name":"Footer","settings":[
  {"type":"color","id":"bg_color","label":"Background","default":"#1A1A1A"},
  {"type":"color","id":"text_color","label":"Text","default":"#F5F1EB"},
  {"type":"textarea","id":"tagline","label":"Brand tagline","default":"Skincare, body, and wellness for the version of you that's coming next."},
  {"type":"text","id":"instagram_handle","label":"Instagram handle (no @)","default":"[REAL_HANDLE_PLACEHOLDER]"},
  {"type":"text","id":"whatsapp_number","label":"WhatsApp number (digits only, e.g. 919999999999)","default":"[REAL_NUMBER_PLACEHOLDER]"}
],"enabled_on":{"groups":["footer"]}}
{% endschema %}
