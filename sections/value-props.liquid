<div class="vp" style="background:{{ section.settings.bg_color | default: '#D2340D' }};color:{{ section.settings.text_color | default: '#FFFFFF' }}">
  <div class="pw">
    {%- if section.settings.heading != blank -%}
      <div class="sh sh--invert">
        {%- if section.settings.eyebrow != blank -%}<p class="vp__eye">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="vp__hd">{{ section.settings.heading }}</h2>
        {%- if section.settings.subtext != blank -%}<p class="vp__sub">{{ section.settings.subtext }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="vp__grid">
      {%- for block in section.blocks -%}
        <div class="vp__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="vp__icon-wrap"><img src="{{ block.settings.image | image_url: width: 200 }}" alt="" loading="lazy"></div>
          {%- elsif block.settings.icon != blank -%}
            <div class="vp__icon-wrap vp__icon-wrap--emoji">{{ block.settings.icon }}</div>
          {%- endif -%}
          <div class="vp__txt">
            <h3 class="vp__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="vp__text">{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
.vp{padding:32px 0}
@media(min-width:768px){.vp{padding:64px 0}}
.vp__eye{font-family:var(--f-body);font-size:13px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:inherit;opacity:.85;margin:0 0 12px;text-align:center}
.vp__hd{font-family:var(--f-display);font-size:clamp(24px,3vw,34px);font-weight:500;letter-spacing:-.02em;color:inherit;margin:0 0 12px;text-align:center}
.vp__sub{color:inherit;opacity:.85;font-size:15px;text-align:center;max-width:560px;margin:0 auto 32px}
.vp__grid{display:grid;grid-template-columns:1fr;gap:16px}
@media(min-width:600px){.vp__grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:990px){.vp__grid{grid-template-columns:repeat(4,1fr);gap:20px}}
.vp__card{background:#fff;color:var(--c-text);border-radius:8px;padding:20px 18px;display:flex;align-items:center;gap:14px;min-height:auto}
@media(min-width:600px){.vp__card{padding:28px 24px;gap:18px;min-height:140px}}
.vp__icon-wrap{flex-shrink:0;width:56px;height:56px;display:flex;align-items:center;justify-content:center;color:var(--c-text)}
.vp__icon-wrap--emoji{font-size:36px}
.vp__icon-wrap img{width:100%;height:100%;object-fit:contain}
.vp__txt{flex:1;min-width:0}
.vp__title{font-family:var(--f-display);font-size:18px;font-weight:700;line-height:1.2;margin:0 0 6px;color:var(--c-text)}
.vp__text{font-size:13px;color:var(--c-muted);line-height:1.5;margin:0}
</style>

{% schema %}
{"name":"Value props","settings":[
  {"type":"color","id":"bg_color","label":"Background","default":"#D2340D"},
  {"type":"color","id":"text_color","label":"Heading/eyebrow text","default":"#FFFFFF"},
  {"type":"text","id":"eyebrow","label":"Eyebrow"},
  {"type":"text","id":"heading","label":"Heading"},
  {"type":"textarea","id":"subtext","label":"Subtext"}
],"blocks":[{"type":"item","name":"Value prop","limit":4,"settings":[
  {"type":"image_picker","id":"image","label":"Icon image (optional)"},
  {"type":"text","id":"icon","label":"Emoji icon (fallback)","default":"🚚"},
  {"type":"text","id":"title","label":"Title","default":"Free & Fast Delivery"},
  {"type":"textarea","id":"text","label":"Text","default":"Get orders faster while avoiding shipping fees"}
]}],"presets":[{"name":"Value props","blocks":[
  {"type":"item","settings":{"icon":"🚚","title":"Free & Fast Delivery","text":"Get orders faster while avoiding shipping fees"}},
  {"type":"item","settings":{"icon":"✓","title":"Quality Assurance","text":"Carefully sourced and batch-checked before dispatch."}},
  {"type":"item","settings":{"icon":"⭐","title":"Customer Satisfaction","text":"Your happiness is our priority"}},
  {"type":"item","settings":{"icon":"🔒","title":"Secure Shopping","text":"Shop with confidence"}}
]}]}
{% endschema %}
