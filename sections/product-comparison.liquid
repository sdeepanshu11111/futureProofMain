{%- comment -%}
  Two-column "why we're going viral" comparison: copy on the left, an
  Us-vs-Others feature table on the right. Each row is a block.
  Gated to a single product via the "Only show on product handle" setting —
  if set, the section renders only when product.handle matches.
{%- endcomment -%}

{%- assign gate = section.settings.target_handle | strip -%}
{%- if gate == blank or product.handle == gate -%}
  {%- assign accent = section.settings.accent_color | default: '#E8431F' -%}
  <section class="pcmp" style="background:{{ section.settings.bg_color | default: '#FFFFFF' }};color:{{ section.settings.text_color | default: '#15171A' }}">
    <div class="pw">
      <div class="pcmp__grid">
        <div class="pcmp__copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="pcmp__eye">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="pcmp__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="pcmp__text rte">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>

        <div class="pcmp__table" style="--accent:{{ accent }}">
          <div class="pcmp__inner">
            <div class="pcmp__head" role="row">
              <span class="pcmp__head-spacer" aria-hidden="true"></span>
              <span class="pcmp__head-us">{{ section.settings.us_label | default: 'Us' }}</span>
              <span class="pcmp__head-them">{{ section.settings.them_label | default: 'Others' }}</span>
            </div>
            {%- for block in section.blocks -%}
              <div class="pcmp__row" role="row" {{ block.shopify_attributes }}>
                <span class="pcmp__feature">{{ block.settings.feature }}</span>
                <span class="pcmp__cell pcmp__cell--us" aria-label="Yes">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span class="pcmp__cell pcmp__cell--them" aria-label="No">
                  {%- if block.settings.them_check -%}
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
                  {%- endif -%}
                </span>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
  .pcmp{padding:40px 0}
  @media(min-width:850px){.pcmp{padding:80px 0}}
  .pcmp__grid{display:grid;grid-template-columns:1fr;gap:28px;align-items:center}
  @media(min-width:850px){.pcmp__grid{grid-template-columns:1fr 1.05fr;gap:clamp(40px,6vw,96px)}}
  .pcmp__copy{text-align:center}
  @media(min-width:850px){.pcmp__copy{text-align:left}}
  .pcmp__eye{font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--accent,inherit);margin:0 0 14px}
  .pcmp__heading{font-family:var(--f-display);font-size:clamp(26px,7vw,46px);font-weight:700;line-height:1.1;letter-spacing:-.02em;margin:0 0 16px;color:inherit}
  .pcmp__text{font-size:15px;line-height:1.65;opacity:.72}
  .pcmp__text p{margin:0 0 10px}.pcmp__text p:last-child{margin:0}

  /* Unified card with one continuous red highlight column */
  .pcmp__table{position:relative}
  .pcmp__inner{border-radius:18px;overflow:hidden;background:#fff;box-shadow:0 1px 0 rgba(0,0,0,.04),0 24px 50px -34px rgba(0,0,0,.5),0 0 0 1px rgba(20,23,26,.05)}
  .pcmp__head,.pcmp__row{display:grid;grid-template-columns:1fr 96px 76px;align-items:stretch}
  @media(min-width:480px){.pcmp__head,.pcmp__row{grid-template-columns:1fr 108px 90px}}
  @media(min-width:850px){.pcmp__head,.pcmp__row{grid-template-columns:1fr 124px 104px}}
  .pcmp__head-spacer,.pcmp__head-us,.pcmp__head-them{display:flex;align-items:center;justify-content:center;text-align:center}
  .pcmp__head-us,.pcmp__head-them{font-family:var(--f-display);font-weight:700;line-height:1.18;padding:14px 8px;overflow-wrap:break-word;hyphens:none}
  .pcmp__head-us{font-size:13px;color:#fff;background:var(--accent)}
  @media(min-width:480px){.pcmp__head-us{font-size:14px}}
  @media(min-width:850px){.pcmp__head-us{font-size:15.5px}}
  .pcmp__head-them{font-size:13.5px;color:#15171A;opacity:.75}
  @media(min-width:480px){.pcmp__head-them{font-size:14px}}
  @media(min-width:850px){.pcmp__head-them{font-size:15.5px}}
  .pcmp__feature{display:flex;align-items:center;padding:15px 16px;font-size:14px;font-weight:600;line-height:1.35;color:#15171A}
  @media(min-width:850px){.pcmp__feature{padding:18px 24px;font-size:15px}}
  .pcmp__cell{display:flex;align-items:center;justify-content:center}
  .pcmp__cell--us{background:var(--accent)}
  .pcmp__cell--them{color:#C9CDD3}
  /* row dividers on the white cells only, keeping the red column solid */
  .pcmp__row .pcmp__feature,.pcmp__row .pcmp__cell--them{border-top:1px solid #EEF0F2}
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Product comparison",
  "settings": [
    {"type": "paragraph", "content": "Two-column comparison table. Leave 'Only show on product handle' set so it appears only on that one product."},
    {"type": "text", "id": "target_handle", "label": "Only show on product handle", "info": "e.g. biodance-bio-collagen-real-deep-mask. Leave blank to show on every product.", "default": "biodance-bio-collagen-real-deep-mask"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Why we're going viral"},
    {"type": "richtext", "id": "text", "label": "Paragraph", "default": "<p>Unlike gimmicky skincare, our Bio-Collagen Real Deep Mask is built on real ingredients and designed for visible, lasting results. Overnight, it works to hydrate, firm and replenish your skin — no needles, no fuss.</p>"},
    {"type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#15171A"},
    {"type": "color", "id": "accent_color", "label": "Accent (our column)", "default": "#E8431F"},
    {"type": "text", "id": "us_label", "label": "Our column label", "default": "BIODANCE Mask"},
    {"type": "text", "id": "them_label", "label": "Their column label", "default": "Others"}
  ],
  "blocks": [
    {"type": "row", "name": "Comparison row", "settings": [
      {"type": "text", "id": "feature", "label": "Feature", "default": "Visible results overnight"},
      {"type": "checkbox", "id": "them_check", "label": "Others also have this?", "default": false}
    ]}
  ],
  "presets": [
    {"name": "Product comparison", "blocks": [
      {"type": "row", "settings": {"feature": "Visible results overnight"}},
      {"type": "row", "settings": {"feature": "Real bio-collagen, not gimmicks"}},
      {"type": "row", "settings": {"feature": "Deeply hydrates & firms skin"}},
      {"type": "row", "settings": {"feature": "Mess-free, easy peel-off"}},
      {"type": "row", "settings": {"feature": "Clean, skin-safe formula"}}
    ]}
  ]
}
{% endschema %}
