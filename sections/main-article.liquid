<article class="section"><div class="pw" style="max-width:760px">
<a href="{{ blog.url }}" style="font-size:13px;color:var(--c-accent);text-decoration:underline;text-underline-offset:3px;display:inline-block;margin-bottom:18px">← Back to journal</a>
<p class="sh__eye" style="text-align:left">{{ article.published_at | date: '%B %d, %Y' }}</p>
<h1 class="sh__title sh--left" style="text-align:left">{{ article.title }}</h1>
{%- if article.image -%}<div style="aspect-ratio:16/9;overflow:hidden;border-radius:var(--r-lg);margin:24px 0 32px;background:var(--c-surface-2)"><img src="{{ article.image | image_url: width: 1800 }}" alt="{{ article.image.alt | escape }}" style="width:100%;height:100%;object-fit:cover"></div>{%- endif -%}
<div class="rte">{{ article.content }}</div>
</div></article>
{% schema %}{"name":"Article","settings":[],"enabled_on":{"templates":["article"]}}{% endschema %}
