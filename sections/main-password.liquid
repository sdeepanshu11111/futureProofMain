<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:48px 20px;background:linear-gradient(135deg,#FAF6F0,#F5DBE0)">
<div style="max-width:540px;width:100%;text-align:center">
{%- if settings.logo != blank -%}<img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" style="max-width:200px;margin:0 auto 32px">{%- else -%}<h1 style="font-family:var(--f-display);font-size:36px;margin:0 0 32px;font-weight:600">{{ shop.name }}</h1>{%- endif -%}
<h2 style="font-family:var(--f-display);font-size:clamp(28px,5vw,44px);margin:0 0 14px;line-height:1.1">{{ section.settings.heading | default: 'Something special is coming.' }}</h2>
<p style="color:var(--c-muted);margin:0 0 32px;font-size:16px">{{ section.settings.subtext | default: 'Sign up to be the first to know when we launch.' }}</p>
{%- form 'customer' -%}<input type="hidden" name="contact[tags]" value="prospect">
<div style="display:flex;gap:8px;max-width:420px;margin:0 auto">
<input type="email" name="contact[email]" placeholder="Email address" required style="flex:1;padding:15px 18px;border:1.5px solid var(--c-border);border-radius:var(--r-md);font-family:inherit;font-size:15px;background:var(--c-surface);color:var(--c-text)">
<button type="submit" class="btn btn--primary">Notify me</button>
</div>
{%- if form.posted_successfully? -%}<p style="color:var(--c-success);margin-top:14px;font-size:14px">Thanks — we'll be in touch!</p>{%- endif -%}
{%- endform -%}
<div style="margin-top:60px;font-size:13px;color:var(--c-muted)">
<p style="margin:0 0 14px">Are you the store owner? <a href="#" style="color:var(--c-accent);text-decoration:underline" onclick="document.getElementById('pw-form').style.display='block';return false">Log in here</a></p>
<div id="pw-form" style="display:none;max-width:380px;margin:0 auto">
{%- form 'storefront_password' -%}{%- if form.errors -%}<p style="color:var(--c-urgent);font-size:13px">Incorrect password.</p>{%- endif -%}
<div style="display:flex;gap:8px"><input type="password" name="password" placeholder="Password" style="flex:1;padding:13px 16px;border:1.5px solid var(--c-border);border-radius:var(--r-md);font-family:inherit;background:var(--c-surface);color:var(--c-text)"><button type="submit" class="btn btn--outline">Enter</button></div>
{%- endform -%}
</div></div>
</div></div>
{% schema %}{"name":"Password","settings":[{"type":"text","id":"heading","label":"Heading","default":"Something special is coming."},{"type":"textarea","id":"subtext","label":"Subtext"}],"enabled_on":{"templates":["password"]}}{% endschema %}
