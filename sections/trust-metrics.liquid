<div class="tm" style="background:{{ section.settings.bg_color | default: '#1F1614' }};color:{{ section.settings.text_color | default: '#FFFFFF' }}">
  <div class="pw">
    <div class="tm__grid">
      {%- for block in section.blocks -%}
        <div class="tm__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span class="tm__icon" aria-hidden="true">{{ block.settings.icon }}</span>
          {%- endif -%}
          <div class="tm__text">
            <p class="tm__num">{{ block.settings.number }}</p>
            {%- if block.settings.label != blank -%}
              <p class="tm__label">{{ block.settings.label }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
.tm{padding:18px 0}
@media(min-width:768px){.tm{padding:28px 0}}
.tm__grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
  align-items:stretch;
}
@media(min-width:768px){
  .tm__grid{grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:0}
}
.tm__item{
  display:flex;
  align-items:center;
  gap:12px;
  padding:14px 14px;
  border-radius:14px;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.06);
  min-height:64px;
}
@media(min-width:768px){
  .tm__item{
    background:transparent;
    border:0;
    border-right:1px solid rgba(255,255,255,.10);
    border-radius:0;
    justify-content:center;
    padding:8px 18px;
  }
  .tm__item:last-child{border-right:0}
}
.tm__icon{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:36px;height:36px;
  flex-shrink:0;
  border-radius:50%;
  background:rgba(255,255,255,.08);
  font-size:18px;
  line-height:1;
}
@media(min-width:768px){.tm__icon{width:40px;height:40px;font-size:20px}}
.tm__text{min-width:0}
.tm__num{
  font-family:var(--f-display);
  font-size:14px;
  font-weight:600;
  letter-spacing:-.005em;
  margin:0;
  line-height:1.2;
}
@media(min-width:768px){.tm__num{font-size:16px}}
.tm__label{
  font-size:11px;
  font-weight:500;
  letter-spacing:.02em;
  margin:2px 0 0;
  opacity:.65;
  line-height:1.3;
}
</style>

{% schema %}
{"name":"Trust metrics","settings":[
  {"type":"color","id":"bg_color","label":"Background","default":"#1F1614"},
  {"type":"color","id":"text_color","label":"Text","default":"#FFFFFF"}
],"blocks":[{"type":"item","name":"Metric","limit":4,"settings":[
  {"type":"text","id":"icon","label":"Icon (emoji)","default":"⭐"},
  {"type":"text","id":"number","label":"Number","default":"4.8/5"},
  {"type":"text","id":"label","label":"Label","default":"Average rating"}
]}],"max_blocks":4,"presets":[{"name":"Trust metrics","blocks":[
  {"type":"item","settings":{"icon":"⭐","number":"4.8/5","label":"From 5,000+ reviews"}},
  {"type":"item","settings":{"icon":"💝","number":"10K+","label":"Happy customers"}},
  {"type":"item","settings":{"icon":"🇮🇳","number":"Made","label":"In India, for India"}},
  {"type":"item","settings":{"icon":"💵","number":"COD","label":"Available pan-India"}}
]}]}
{% endschema %}
