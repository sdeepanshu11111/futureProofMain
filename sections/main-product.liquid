{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
    assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
  endif

  assign tagline = product.metafields.custom.tagline
  assign variant_heading = product.metafields.custom.variant_heading

  assign mf_rating = product.metafields.custom.rating
  assign mf_review_count = product.metafields.custom.review_count
  assign mf_testimonial_title = product.metafields.custom.testimonial_title
  assign mf_testimonial_text = product.metafields.custom.testimonial_text
  assign mf_testimonial_name = product.metafields.custom.testimonial_name
  assign mf_testimonial_image = product.metafields.custom.testimonial_image
  assign mf_trust_badges = product.metafields.custom.trust_badges
  assign mf_variant_labels = product.metafields.custom.variant_labels

  assign accent_color = product.metafields.custom.accent_color
  if accent_color == blank
    assign accent_color = '#2E5BFF'
  endif
  assign accent_soft = product.metafields.custom.accent_soft
  if accent_soft == blank
    assign accent_soft = '#EFF3FF'
  endif

  assign cta_label = section.settings.cta_label | default: 'ADD TO CART'

  assign now_seconds = 'now' | date: '%s' | times: 1
  assign delivery_days = section.settings.delivery_days | default: 3
  assign delivery_seconds = delivery_days | times: 86400 | plus: now_seconds
  assign delivery_date = delivery_seconds | date: '%a, %b %d'
-%}

<section class="np" id="np-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="pw">
    <div class="np__grid">

      {%- comment -%} ===== Gallery ===== {%- endcomment -%}
      <div class="np__gallery">
        <div class="np__main" data-gallery-main>
          {%- for img in product.images -%}
            <div class="np__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}">
              <img src="{{ img | image_url: width: 1400 }}"
                   alt="{{ img.alt | escape }}"
                   width="{{ img.width }}"
                   height="{{ img.height }}"
                   loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                   fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}">
            </div>
          {%- else -%}
            <div class="np__slide is-active">{{ 'product-1' | placeholder_svg_tag: 'np__placeholder' }}</div>
          {%- endfor -%}

          {%- if product.images.size > 1 -%}
            <button type="button" class="np__nav np__nav--prev" data-gallery-prev aria-label="Previous image">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button type="button" class="np__nav np__nav--next" data-gallery-next aria-label="Next image">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
            <div class="np__dots">
              {%- for img in product.images -%}
                <span class="np__dot{% if forloop.first %} is-active{% endif %}" data-dot="{{ forloop.index0 }}"></span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="np__thumbs">
            {%- for img in product.images -%}
              <button class="np__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ forloop.index0 }}" type="button" aria-label="Image {{ forloop.index }}">
                <img src="{{ img | image_url: width: 220 }}" alt="" width="110" height="110" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ===== Buy Box ===== {%- endcomment -%}
      <div class="np__buy">

        {%- if mf_rating != blank -%}
          <div class="np__rating">
            <div class="np__stars" aria-label="Rated {{ mf_rating }} out of 5">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 24 24" width="16" height="16" fill="{{ accent_color }}" stroke="{{ accent_color }}" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              {%- endfor -%}
            </div>
            <span class="np__rating-num">{{ mf_rating }}</span>
            {%- if mf_review_count != blank -%}
              <span class="np__rating-count">- {{ mf_review_count }} Reviews</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        <h1 class="np__title">{{ product.title }}</h1>

        {%- assign price_parts = product.price | money_without_currency | split: '.' -%}
        {%- assign compare_parts = product.compare_at_price | money_without_currency | split: '.' -%}
        <div class="np__price-row">
          {%- if on_sale -%}
            <s class="np__compare">Rs. {{ compare_parts[0] }}</s>
          {%- endif -%}
          <span class="np__price">Rs. {{ price_parts[0] }}</span>
          {%- if on_sale -%}
            <span class="np__save">↓ SAVE {{ savings }}%</span>
          {%- endif -%}
        </div>

        {%- if tagline != blank -%}
          <p class="np__tagline">{{ tagline }}</p>
        {%- endif -%}

        {%- comment -%} Feature bullets — driven entirely by product metafield custom.bullets (multi-line text, one bullet per line as "Title: Description"). If not set on the product, this list is omitted. {%- endcomment -%}
        {%- assign mf_bullets = product.metafields.custom.bullets -%}
        {%- if mf_bullets != blank -%}
          {%- assign bullet_lines = mf_bullets | newline_to_br | split: '<br />' -%}
          <ul class="np__bullets">
            {%- for raw_line in bullet_lines -%}
              {%- assign line = raw_line | strip -%}
              {%- if line != blank -%}
                {%- if line contains ':' -%}
                  {%- assign b_title = line | split: ':' | first | strip -%}
                  {%- assign b_text = line | remove_first: b_title | remove_first: ':' | strip -%}
                {%- else -%}
                  {%- assign b_title = line -%}
                  {%- assign b_text = '' -%}
                {%- endif -%}
                <li class="np__bullet">
                  <span class="np__bullet-check">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  </span>
                  <span class="np__bullet-text">{%- if b_text != blank -%}<strong>{{ b_title }}:</strong> {{ b_text }}{%- else -%}{{ b_title }}{%- endif -%}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="np__form" data-np-form>

          {%- unless product.has_only_default_variant -%}
            {%- if variant_heading != blank -%}
              <div class="np__variant-head">
                <span>{{ variant_heading }}</span>
              </div>
            {%- endif -%}
            {%- comment -%} Variant labels read from product metafield custom.variant_labels — one line per variant, format "Tag|Badge" (badge optional). If empty, no labels show but variants still render. {%- endcomment -%}
            {%- assign variant_label_lines = mf_variant_labels | newline_to_br | split: '<br />' -%}
            <div class="np__variants" role="radiogroup" aria-label="Select pack">
              {%- for v in product.variants -%}
                {%- assign v_on_sale = false -%}
                {%- if v.compare_at_price > v.price -%}{%- assign v_on_sale = true -%}{%- endif -%}
                {%- assign label_parts = v.title | split: ' / ' -%}
                {%- assign v_name = label_parts[0] -%}
                {%- assign v_sub = label_parts[1] -%}
                {%- assign tag_text = '' -%}
                {%- assign badge = '' -%}
                {%- assign current_label_line = variant_label_lines[forloop.index0] | default: '' | strip -%}
                {%- if current_label_line != blank -%}
                  {%- assign label_pieces = current_label_line | split: '|' -%}
                  {%- assign tag_text = label_pieces[0] | strip -%}
                  {%- if label_pieces.size > 1 -%}
                    {%- assign badge = label_pieces[1] | strip -%}
                  {%- endif -%}
                {%- endif -%}

                <label class="np__variant{% if v == product.selected_or_first_available_variant %} is-selected{% endif %}{% unless v.available %} is-disabled{% endunless %}">
                  <input type="radio" name="id" value="{{ v.id }}"
                         {% if v == product.selected_or_first_available_variant %}checked{% endif %}
                         {% unless v.available %}disabled{% endunless %}>
                  <span class="np__variant-radio" aria-hidden="true"></span>
                  <span class="np__variant-info">
                    <span class="np__variant-name">{{ v_name }}</span>
                    {%- if tag_text != blank -%}
                      <span class="np__variant-tag">{{ tag_text }}</span>
                    {%- endif -%}
                  </span>
                  {%- assign v_price_parts = v.price | money_without_currency | split: '.' -%}
                  {%- assign v_compare_parts = v.compare_at_price | money_without_currency | split: '.' -%}
                  <span class="np__variant-price">
                    {%- if v_on_sale -%}
                      <s>Rs. {{ v_compare_parts[0] }}</s>
                    {%- endif -%}
                    <strong>Rs. {{ v_price_parts[0] }}</strong>
                  </span>
                  {%- if badge != blank -%}
                    <span class="np__variant-badge np__variant-badge--{% if forloop.index == 2 %}popular{% else %}loved{% endif %}">{{ badge }}</span>
                  {%- endif -%}
                </label>
              {%- endfor -%}
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          {%- endunless -%}

          <input type="hidden" name="quantity" value="1">

          {%- if section.settings.show_delivery -%}
            <div class="np__delivery">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
              <span>Get it by <strong>{{ delivery_date }}</strong>, if you order within <strong data-np-window>1h 16m</strong></span>
            </div>
          {%- endif -%}

          <button type="submit" class="np__atc" data-atc {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}{{ cta_label }}{% else %}SOLD OUT{% endif %}
          </button>
        </form>

        {%- if mf_testimonial_text != blank -%}
          <div class="np__testimonial">
            <div class="np__testimonial-avatar">
              {%- if mf_testimonial_image != blank -%}
                <img src="{{ mf_testimonial_image | image_url: width: 80 }}" alt="" width="46" height="46">
              {%- elsif mf_testimonial_name != blank -%}
                <span>{{ mf_testimonial_name | slice: 0 }}</span>
              {%- else -%}
                <span>A</span>
              {%- endif -%}
            </div>
            <div class="np__testimonial-body">
              <div class="np__testimonial-stars">
                {%- for i in (1..5) -%}
                  <svg viewBox="0 0 24 24" width="11" height="11" fill="{{ accent_color }}" stroke="{{ accent_color }}"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                {%- endfor -%}
                {%- if mf_testimonial_title != blank -%}
                  <strong class="np__testimonial-title">{{ mf_testimonial_title }}</strong>
                {%- endif -%}
              </div>
              <p class="np__testimonial-text">{{ mf_testimonial_text }}</p>
            </div>
            <div class="np__testimonial-nav" aria-hidden="true">
              <button type="button" class="np__testimonial-arrow" aria-label="Previous">‹</button>
              <button type="button" class="np__testimonial-arrow" aria-label="Next">›</button>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Trust badges from product metafield custom.trust_badges — one label per line. Hidden if metafield blank. {%- endcomment -%}
        {%- if mf_trust_badges != blank -%}
          {%- assign trust_lines = mf_trust_badges | newline_to_br | split: '<br />' -%}
          <div class="np__trust">
            {%- for raw_label in trust_lines -%}
              {%- assign trust_label = raw_label | strip -%}
              {%- if trust_label != blank -%}
                <div class="np__trust-item">
                  <div class="np__trust-icon">
                    {%- case forloop.index -%}
                      {%- when 1 -%}<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="{{ accent_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
                      {%- when 2 -%}<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="{{ accent_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                      {%- else -%}<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="{{ accent_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                    {%- endcase -%}
                  </div>
                  <span class="np__trust-label">{{ trust_label }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%}
          Accordion panels — Description always comes from product.description.
          Additional panels (Directions / Ingredients / Specs / etc) come from product
          metafield custom.accordions (list of refs → metaobject accordion_item with
          fields title + content). Hidden if both sources empty.
        {%- endcomment -%}
        {%- assign mf_accordions = product.metafields.custom.accordions.value -%}
        {%- if product.description != blank or mf_accordions != blank -%}
          <div class="np__accordions">
            {%- if product.description != blank -%}
              <details class="np__acc">
                <summary class="np__acc-q">
                  <span>Product Description</span>
                  <span class="np__acc-plus" aria-hidden="true">+</span>
                </summary>
                <div class="np__acc-a rte">{{ product.description }}</div>
              </details>
            {%- endif -%}
            {%- if mf_accordions and mf_accordions.size > 0 -%}
              {%- for acc in mf_accordions -%}
                <details class="np__acc">
                  <summary class="np__acc-q">
                    <span>{{ acc.title }}</span>
                    <span class="np__acc-plus" aria-hidden="true">+</span>
                  </summary>
                  <div class="np__acc-a rte">{{ acc.content | metafield_tag }}</div>
                </details>
              {%- endfor -%}
            {%- endif -%}
            {%- comment -%} section-block fallback only when no product context and no metafield {%- endcomment -%}
            {%- if mf_accordions == blank and product == blank -%}
              {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion' -%}
              {%- for block in accordion_blocks -%}
                <details class="np__acc" {{ block.shopify_attributes }}>
                  <summary class="np__acc-q">
                    <span>{{ block.settings.title }}</span>
                    <span class="np__acc-plus" aria-hidden="true">+</span>
                  </summary>
                  <div class="np__acc-a rte">{{ block.settings.content }}</div>
                </details>
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="np__app-slot" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<style>
  #np-{{ section.id }}{
    --np-accent: {{ accent_color }};
    --np-accent-soft: {{ accent_soft }};
    --np-text: #111;
    --np-muted: #6B6B6B;
    --np-border: #E5E5E5;
    --np-cta: #111;
    --np-cta-hover: #000;
    --np-tag: #FFE9B3;
  }
</style>
<style>
.np{background:#FFFFFF;color:var(--np-text);padding:24px 0 48px;font-family:var(--f-body)}
@media(min-width:900px){.np{padding:36px 0 72px}}
.np *{box-sizing:border-box}
.np__grid{display:grid;grid-template-columns:1fr;gap:28px;align-items:start}
@media(min-width:900px){.np__grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px}}

/* Gallery */
.np__gallery{position:sticky;top:84px}
@media(max-width:899px){.np__gallery{position:static}}
.np__main{position:relative;background:#F7F7F7;border-radius:14px;overflow:hidden;aspect-ratio:1/1}
.np__slide{display:none;width:100%;height:100%}
.np__slide.is-active{display:flex;align-items:center;justify-content:center}
.np__slide img,.np__slide svg{width:100%;height:100%;object-fit:contain;display:block}
.np__nav{position:absolute;top:50%;transform:translateY(-50%);width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.92);border:1px solid rgba(0,0,0,.06);display:flex;align-items:center;justify-content:center;cursor:pointer;color:#111;box-shadow:0 2px 8px rgba(0,0,0,.08);transition:background .2s}
.np__nav:hover{background:#fff}
.np__nav--prev{left:12px}
.np__nav--next{right:12px}
.np__dots{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);display:flex;gap:6px}
.np__dot{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.6);transition:background .2s}
.np__dot.is-active{background:#fff}
.np__thumbs{display:flex;gap:8px;margin-top:10px;overflow-x:auto;padding-bottom:2px;scrollbar-width:none}
.np__thumbs::-webkit-scrollbar{display:none}
.np__thumb{flex:0 0 64px;height:64px;border:2px solid transparent;border-radius:8px;overflow:hidden;background:#F3F4F6;padding:0;cursor:pointer;transition:border-color .2s}
.np__thumb.is-active{border-color:var(--np-accent)}
.np__thumb img{width:100%;height:100%;object-fit:cover}

/* Buy box */
.np__buy{display:flex;flex-direction:column;gap:14px}

.np__rating{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--np-muted)}
.np__stars{display:flex;gap:2px}
.np__rating-num{font-weight:600;color:var(--np-text);font-size:14px}
.np__rating-count{font-size:13px}

.np__title{font-family:var(--f-display);font-size:clamp(22px,3vw,30px);font-weight:600;line-height:1.2;margin:0;color:var(--np-text);letter-spacing:-.01em}

.np__price-row{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin:2px 0 0}
.np__compare{font-size:18px;color:#888;text-decoration:line-through;font-weight:400}
.np__price{font-size:26px;font-weight:700;color:var(--np-text)}
.np__save{background:var(--np-accent-soft);color:var(--np-accent);padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700;letter-spacing:.04em}

.np__tagline{font-size:14px;color:var(--np-text);font-weight:600;margin:6px 0 4px;line-height:1.4}

.np__bullets{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px}
.np__bullet{display:flex;align-items:flex-start;gap:10px;font-size:13.5px;line-height:1.5;color:var(--np-text)}
.np__bullet-check{flex-shrink:0;width:18px;height:18px;border-radius:50%;background:var(--np-accent);display:flex;align-items:center;justify-content:center;margin-top:1px}
.np__bullet-text strong{font-weight:600}

/* Variants */
.np__form{display:flex;flex-direction:column;gap:14px;margin-top:8px}
.np__variant-head{font-size:12px;color:var(--np-muted);font-weight:500;letter-spacing:.04em;text-transform:capitalize;padding:0 2px}
.np__variants{display:flex;flex-direction:column;gap:10px}
.np__variant{position:relative;display:flex;align-items:center;gap:12px;padding:18px 14px 14px;border:1.5px solid var(--np-border);border-radius:10px;cursor:pointer;background:#fff;transition:all .15s ease}
.np__variant:hover{border-color:#BFBFBF}
.np__variant.is-selected{border-color:var(--np-accent);background:var(--np-accent-soft)}
.np__variant input{position:absolute;opacity:0;pointer-events:none}
.np__variant-radio{width:18px;height:18px;border:2px solid #BFBFBF;border-radius:50%;flex-shrink:0;position:relative;transition:border-color .15s}
.np__variant.is-selected .np__variant-radio{border-color:var(--np-accent)}
.np__variant.is-selected .np__variant-radio::after{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:9px;height:9px;border-radius:50%;background:var(--np-accent)}
.np__variant-info{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}
.np__variant-name{font-weight:600;font-size:15px;color:var(--np-text)}
.np__variant-tag{display:inline-flex;align-self:flex-start;font-size:11px;color:var(--np-accent);background:var(--np-accent-soft);padding:3px 8px;border-radius:999px;font-weight:600;margin-top:2px}
.np__variant.is-selected .np__variant-tag{background:#fff}
.np__variant-price{display:flex;flex-direction:column;align-items:flex-end;gap:2px;text-align:right;flex-shrink:0}
.np__variant-price s,.np__variant.is-selected .np__variant-price s{font-size:12px;color:#9CA3AF;font-weight:400}
.np__variant-price strong{font-size:15px;font-weight:700;color:var(--np-text)}
.np__variant-badge{position:absolute;top:-10px;right:14px;font-size:10px;font-weight:700;letter-spacing:.06em;padding:4px 10px;border-radius:4px;text-transform:uppercase;background:#FF4D6D;color:#fff;box-shadow:0 2px 6px rgba(255,77,109,.25)}
.np__variant-badge--popular{background:#FF4D6D;color:#fff}
.np__variant-badge--loved{background:var(--np-accent);color:#fff}
.np__variant.is-disabled{opacity:.5;cursor:not-allowed}

.np__delivery{display:flex;align-items:center;gap:8px;font-size:13px;color:#5C5C5C;padding:4px 2px;line-height:1.4}
.np__delivery svg{flex-shrink:0;color:var(--np-accent)}
.np__delivery strong{font-weight:600;color:var(--np-text)}

.np__atc{display:block;width:100%;background:var(--np-cta);color:#fff;border:none;border-radius:10px;padding:16px;font-family:var(--f-body);font-size:14px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;transition:background .2s}
.np__atc:hover{background:var(--np-cta-hover)}
.np__atc[disabled]{opacity:.5;cursor:not-allowed}

/* Testimonial */
.np__testimonial{display:flex;align-items:center;gap:12px;padding:14px;background:#F9FAFB;border:1px solid var(--np-border);border-radius:12px;margin-top:6px}
.np__testimonial-avatar{flex-shrink:0;width:46px;height:46px;border-radius:50%;background:#FFDBD0;color:#993E1F;font-weight:700;display:flex;align-items:center;justify-content:center;overflow:hidden;font-size:18px}
.np__testimonial-avatar img{width:100%;height:100%;object-fit:cover}
.np__testimonial-body{flex:1;min-width:0}
.np__testimonial-stars{display:flex;align-items:center;gap:4px;margin-bottom:2px}
.np__testimonial-title{font-size:13px;font-weight:600;color:var(--np-text);margin-left:4px}
.np__testimonial-text{font-size:12.5px;color:var(--np-muted);margin:0;line-height:1.4}
.np__testimonial-nav{display:flex;flex-direction:column;gap:2px}
.np__testimonial-arrow{background:none;border:none;color:#BFBFBF;font-size:14px;cursor:pointer;padding:0;line-height:1}
.np__testimonial-arrow:hover{color:var(--np-text)}

/* Trust */
.np__trust{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:8px;padding:14px 8px;background:var(--np-accent-soft);border-radius:12px}
.np__trust-item{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px}
.np__trust-icon{width:30px;height:30px;display:flex;align-items:center;justify-content:center}
.np__trust-icon img{max-width:100%;max-height:100%}
.np__trust-label{font-size:11.5px;font-weight:600;color:var(--np-text);line-height:1.3}

/* Accordions */
.np__accordions{margin-top:10px;border-top:1px solid var(--np-border)}
.np__acc{border-bottom:1px solid var(--np-border)}
.np__acc-q{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;padding:16px 4px;font-size:14px;font-weight:600;color:var(--np-text)}
.np__acc-q::-webkit-details-marker{display:none}
.np__acc-plus{font-size:20px;color:var(--np-muted);line-height:1;font-weight:300;transition:transform .25s}
.np__acc[open] .np__acc-plus{transform:rotate(45deg)}
.np__acc-a{padding:0 4px 18px;font-size:13.5px;line-height:1.65;color:var(--np-muted)}
.np__acc-a > *:last-child{margin-bottom:0}

.np__app-slot{margin-top:32px}

/* ============================================================
   MOBILE — conversion-optimized
   ============================================================ */
@media(max-width:899px){
  .np{padding:0 0 96px}
  /* Remove page padding around the product section so the gallery can go edge-to-edge */
  .np > .pw{padding:0;max-width:none}
  .np__grid{gap:10px}
  .np__grid > *{min-width:0}

  /* Gallery — full-bleed on mobile, edge to edge like Nagomi */
  .np__gallery{margin:0;padding:0;width:100%}
  .np__main{border-radius:0;aspect-ratio:1/1;background:#F7F7F7}
  .np__nav{display:none}
  .np__dots{bottom:10px;gap:5px;background:rgba(255,255,255,.7);padding:5px 8px;border-radius:99px;backdrop-filter:blur(4px)}
  .np__dot{width:5px;height:5px;background:rgba(0,0,0,.25)}
  .np__dot.is-active{background:#111;width:14px;border-radius:99px}

  /* Thumbnails — compact, flush-edge horizontal scroll */
  .np__thumbs{gap:6px;margin:6px 16px 0;padding:0 0 2px;overflow-x:auto;scroll-snap-type:x mandatory}
  .np__thumb{flex:0 0 48px;height:48px;border-radius:6px;border:1.5px solid transparent;scroll-snap-align:start;background:#F7F7F7}
  .np__thumb.is-active{border-color:#111}

  /* Buy box keeps its own padding since we removed it from .pw */
  .np__buy{padding:8px 16px 0}

  /* Buy box — tighter rhythm */
  .np__buy{gap:10px}

  .np__rating{font-size:12.5px;gap:6px;margin-top:4px}
  .np__rating-num{font-size:13px}
  .np__rating-count{font-size:12px}

  .np__title{font-size:21px;line-height:1.18;font-weight:700;letter-spacing:-.02em;margin-top:2px}

  .np__price-row{gap:8px;margin-top:2px;align-items:center}
  .np__compare{font-size:15px}
  .np__price{font-size:26px;letter-spacing:-.01em}
  .np__save{font-size:10.5px;padding:4px 8px;font-weight:800;letter-spacing:.05em}

  .np__tagline{font-size:13.5px;margin:0;font-weight:600;line-height:1.4;color:#333}

  /* Bullets — readable, full-width hit areas */
  .np__bullets{gap:8px;margin-top:2px}
  .np__bullet{font-size:13.5px;line-height:1.4;gap:8px}
  .np__bullet-check{width:18px;height:18px}

  /* Form */
  .np__form{gap:12px;margin-top:6px}
  .np__variant-head{font-size:12px;text-align:center;display:flex;align-items:center;gap:10px;color:#6B6B6B}
  .np__variant-head::before,.np__variant-head::after{content:'';flex:1;height:1px;background:#E5E5E5}

  /* Variant cards — large tap targets, all numbers thumb-reachable */
  .np__variants{gap:9px}
  .np__variant{padding:16px 14px 14px;border-radius:12px;gap:10px;min-height:64px}
  .np__variant-radio{width:20px;height:20px}
  .np__variant-name{font-size:15px;font-weight:700}
  .np__variant-tag{font-size:11px;padding:3px 8px}
  .np__variant-price s{font-size:11.5px}
  .np__variant-price strong{font-size:15px}
  .np__variant-badge{top:-9px;right:12px;font-size:9.5px;padding:3px 8px;letter-spacing:.06em;border-radius:4px}

  /* Delivery row */
  .np__delivery{font-size:12.5px;padding:8px 12px;background:#F9FAFB;border-radius:8px;line-height:1.45}
  .np__delivery svg{width:18px;height:18px}

  /* Hero ATC — big, prominent, easy to tap */
  .np__atc{padding:20px;font-size:15px;letter-spacing:.14em;border-radius:12px;font-weight:800;box-shadow:0 8px 24px rgba(0,0,0,.18);position:relative}
  .np__atc::after{content:'→';margin-left:8px;display:inline-block;font-weight:700;letter-spacing:0}

  /* Testimonial — stack arrow row below body on small screens */
  .np__testimonial{padding:12px;gap:10px;border-radius:10px;align-items:flex-start}
  .np__testimonial-avatar{width:40px;height:40px;font-size:15px}
  .np__testimonial-title{font-size:12.5px}
  .np__testimonial-text{font-size:12px;line-height:1.4}
  .np__testimonial-nav{display:none}

  /* Trust badges — full readable text, more breathing room */
  .np__trust{padding:14px 6px;gap:6px;margin-top:4px;border-radius:10px}
  .np__trust-item{gap:4px}
  .np__trust-icon{width:26px;height:26px}
  .np__trust-icon svg{width:22px!important;height:22px!important}
  .np__trust-label{font-size:11px;letter-spacing:-.005em}

  /* Accordions — bigger tap target */
  .np__accordions{margin-top:8px}
  .np__acc-q{padding:18px 4px;font-size:14.5px}
  .np__acc-a{font-size:14px;padding:0 4px 20px;line-height:1.6;color:#444}
}

/* Very small screens (<= 360px) */
@media(max-width:360px){
  .np__title{font-size:20px}
  .np__price{font-size:22px}
  .np__variant{padding:14px 12px 12px}
  .np__variant-name{font-size:14px}
  .np__variant-price strong{font-size:14px}
  .np__trust-label{font-size:10.5px}
}
</style>

<script>
(function(){
  var root = document.getElementById('np-{{ section.id }}');
  if(!root) return;

  /* Gallery */
  var thumbs = root.querySelectorAll('[data-thumb]');
  var slides = root.querySelectorAll('[data-slide]');
  var dots = root.querySelectorAll('[data-dot]');
  var prev = root.querySelector('[data-gallery-prev]');
  var next = root.querySelector('[data-gallery-next]');
  var current = 0;

  function show(idx){
    if(idx < 0) idx = slides.length - 1;
    if(idx >= slides.length) idx = 0;
    current = idx;
    slides.forEach(function(s){ s.classList.toggle('is-active', parseInt(s.getAttribute('data-slide'),10) === idx); });
    thumbs.forEach(function(t){ t.classList.toggle('is-active', parseInt(t.getAttribute('data-thumb'),10) === idx); });
    dots.forEach(function(d){ d.classList.toggle('is-active', parseInt(d.getAttribute('data-dot'),10) === idx); });
  }
  thumbs.forEach(function(btn){ btn.addEventListener('click', function(){ show(parseInt(btn.getAttribute('data-thumb'),10)); }); });
  dots.forEach(function(d){ d.addEventListener('click', function(){ show(parseInt(d.getAttribute('data-dot'),10)); }); });
  if(prev) prev.addEventListener('click', function(){ show(current - 1); });
  if(next) next.addEventListener('click', function(){ show(current + 1); });

  /* Variant selection */
  var variants = root.querySelectorAll('.np__variant');
  variants.forEach(function(v){
    var input = v.querySelector('input[type=radio]');
    if(!input) return;
    input.addEventListener('change', function(){
      variants.forEach(function(x){ x.classList.remove('is-selected'); });
      v.classList.add('is-selected');
    });
    v.addEventListener('click', function(){ if(!input.disabled){ input.checked = true; input.dispatchEvent(new Event('change')); } });
  });

  /* AJAX add-to-cart → open drawer instead of redirect */
  var form = root.querySelector('[data-np-form]');
  if(form){
    form.addEventListener('submit', function(e){
      var checked = form.querySelector('input[name="id"]:checked') || form.querySelector('input[name="id"]');
      if(!checked || !checked.value) return;
      e.preventDefault();
      var btn = form.querySelector('[data-atc]');
      var orig = btn ? btn.textContent : '';
      if(btn){ btn.disabled = true; btn.textContent = 'Adding…'; }
      fetch((window.theme && window.theme.routes && window.theme.routes.cart_add) || '/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type':'application/json', 'Accept':'application/json'},
        body: JSON.stringify({ id: parseInt(checked.value, 10), quantity: 1 })
      })
      .then(function(r){ return r.json().then(function(d){ return {ok:r.ok, data:d}; }); })
      .then(function(res){
        if(btn){ btn.disabled = false; btn.textContent = orig; }
        if(!res.ok){
          alert((res.data && res.data.description) || 'Could not add to cart.');
          return;
        }
        document.dispatchEvent(new CustomEvent('cart:updated'));
        document.dispatchEvent(new CustomEvent('cart:open'));
      })
      .catch(function(){
        if(btn){ btn.disabled = false; btn.textContent = orig; }
      });
    });
  }

  /* Countdown window for delivery */
  var win = root.querySelector('[data-np-window]');
  if(win){
    var end = new Date();
    end.setHours(end.getHours() + 1);
    end.setMinutes(end.getMinutes() + 16);
    function tick(){
      var diff = end - new Date();
      if(diff <= 0){ win.textContent = '0h 0m'; return; }
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      win.textContent = h + 'h ' + m + 'm';
    }
    tick();
    setInterval(tick, 30000);
  }
})();
</script>

