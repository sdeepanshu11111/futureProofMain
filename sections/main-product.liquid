{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

<section class="pdp" id="pdp-{{ section.id }}">
  <div class="pw">
    <div class="pdp__grid">

      {%- comment -%} Gallery {%- endcomment -%}
      <div class="pdp__gallery">
        <div class="pdp__main" data-gallery-main>
          {%- for img in product.images -%}
            <div class="pdp__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}">
              <img src="{{ img | image_url: width: 1400 }}" alt="{{ img.alt | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}">
            </div>
          {%- else -%}
            <div class="pdp__slide is-active">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="pdp__thumbs">
            {%- for img in product.images -%}
              <button class="pdp__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ forloop.index0 }}" type="button" aria-label="Image {{ forloop.index }}">
                <img src="{{ img | image_url: width: 220 }}" alt="" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Buy box {%- endcomment -%}
      <div class="pdp__buy">
        <div class="pdp__bestseller-badge">BESTSELLER</div>
        <h1 class="pdp__title">{{ product.title }}</h1>
        
        <div class="pdp__reviews-row">
          <div class="pdp__stars">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#D4A843" stroke="#D4A843"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#D4A843" stroke="#D4A843"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#D4A843" stroke="#D4A843"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#D4A843" stroke="#D4A843"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#D4A843" stroke="#D4A843"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          </div>
          <span class="pdp__review-score">4.9</span>
          <span class="pdp__review-count">(240 Reviews)</span>
          <a href="#reviews" class="pdp__review-link">Read all</a>
        </div>

        <div class="pdp__timer-box">
          <div class="pdp__timer-label">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            Limited Time Offer Ends In:
          </div>
          <div class="pdp__timer-digits">
            <span>08</span> : <span>45</span> : <span>22</span>
          </div>
        </div>

        <div class="pdp__price-row">
          <span class="pdp__price{% if on_sale %} pdp__price--sale{% endif %}">
            {%- if product.price_varies -%}From {% endif -%}{{ product.price | money }}
          </span>
          {%- if on_sale -%}
            <s class="pdp__compare">{{ product.compare_at_price | money }}</s>
            <span class="pdp__savings-tag">31% OFF</span>
          {%- endif -%}
        </div>

        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="pdp__form" data-pdp-form>
          {%- unless product.has_only_default_variant -%}
            <label class="pdp__variant-label" for="VariantSelect-{{ section.id }}">Options</label>
            <select id="VariantSelect-{{ section.id }}" name="id" class="pdp__variant-select">
              {%- for v in product.variants -%}
                <option value="{{ v.id }}"{% if v == product.selected_or_first_available_variant %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>
                  {{ v.title }} — {{ v.price | money }}{% unless v.available %} · Sold out{% endunless %}
                </option>
              {%- endfor -%}
            </select>
          {%- else -%}
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          {%- endunless -%}

          <input type="hidden" name="quantity" value="1">

          <button type="submit" class="btn btn--primary btn--xl btn--block pdp__atc" data-atc {% unless product.available %} disabled{% endunless %}>
            {% if product.available %}BUY NOW{% else %}Sold out{% endif %}
          </button>
        </form>

        <div class="pdp__social-proof" id="pdp-social-proof">
          <div class="pdp__sp-avatar">P</div>
          <div class="pdp__sp-text">
            <div class="pdp__sp-title"><strong>Recently bought by Priya from Bangalore</strong></div>
            <div class="pdp__sp-time">2 minutes ago</div>
          </div>
          <button type="button" class="pdp__sp-close" onclick="document.getElementById('pdp-social-proof').style.display='none';">&times;</button>
        </div>

        <div class="pdp__trust-badges" style="display: flex; gap: 16px; margin-top: 16px; font-size: 12px; color: #B3B3B3; align-items: center; font-family: var(--f-body);">
          <div style="display: flex; align-items: center; gap: 6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            Cash on Delivery Available
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            7-Day Easy Returns
          </div>
        </div>

        {%- if product.description != blank -%}
          <div class="pdp__desc rte">{{ product.description }}</div>
        {%- endif -%}
      </div>

    </div>

    {%- comment -%}
      App block slot. Merchants install Judge.me / Loox / etc. as an "@app" block
      from the theme editor; this is where it renders. Nothing shown until installed.
    {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="pdp__apps">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="pdp__app-slot" {{ block.shopify_attributes }}>{% render block %}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
.pdp{padding:32px 0 56px;background-color:var(--c-bg);color:var(--c-text)}
@media(min-width:768px){.pdp{padding:48px 0 80px}}
.pdp__grid{display:grid;grid-template-columns:1fr;gap:32px;align-items:start}
@media(min-width:900px){.pdp__grid{grid-template-columns:1.05fr 1fr;gap:56px}}

.pdp__gallery{position:sticky;top:88px}
@media(max-width:899px){.pdp__gallery{position:static}}
.pdp__main{position:relative;background:var(--c-surface-2);border-radius:var(--r-lg);overflow:hidden;aspect-ratio:4/5;border:1px solid var(--c-border)}
.pdp__slide{display:none;width:100%;height:100%}
.pdp__slide.is-active{display:block}
.pdp__slide img,.pdp__slide svg{width:100%;height:100%;object-fit:cover;display:block}
.pdp__thumbs{display:flex;gap:8px;margin-top:12px;overflow-x:auto;padding-bottom:2px}
.pdp__thumb{flex:0 0 72px;height:72px;border:1px solid var(--c-border);border-radius:8px;overflow:hidden;background:none;padding:0;cursor:pointer;transition:border-color var(--transition)}
.pdp__thumb.is-active{border-color:var(--c-accent)}
.pdp__thumb img{width:100%;height:100%;object-fit:cover}

.pdp__buy{display:flex;flex-direction:column;gap:18px}
.pdp__bestseller-badge{background:#D4A843;color:#ffffff;padding:4px 10px;border-radius:4px;font-size:11px;font-weight:700;display:inline-block;letter-spacing:.1em;align-self:flex-start}
.pdp__title{font-family:var(--f-display);font-size:clamp(28px,3.4vw,38px);font-weight:700;letter-spacing:-.02em;line-height:1.1;margin:0;color:var(--c-text)}

.pdp__reviews-row{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--c-muted);flex-wrap:wrap}
.pdp__stars{display:flex;gap:2px}
.pdp__review-score{font-weight:700;color:var(--c-text)}
.pdp__review-link{color:var(--c-muted);text-decoration:underline;text-underline-offset:3px}
.pdp__review-link:hover{color:var(--c-accent)}

.pdp__timer-box{background:#FFF5F0;border:1px solid #FFDBD0;padding:14px 18px;border-radius:10px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
.pdp__timer-label{display:flex;align-items:center;gap:8px;color:#D43F00;font-weight:600;font-size:14px}
.pdp__timer-digits{display:flex;align-items:center;gap:6px;font-family:var(--f-label, 'Space Mono', monospace);font-weight:700;font-size:16px}
.pdp__timer-digits span{background:#852400;color:#ffffff;padding:4px 8px;border-radius:4px;line-height:1}

.pdp__price-row{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
.pdp__price{font-family:var(--f-label, 'Space Mono', monospace);font-size:28px;font-weight:700;color:var(--c-text);font-variant-numeric:tabular-nums}
.pdp__compare{font-family:var(--f-label, 'Space Mono', monospace);font-size:18px;color:var(--c-muted);text-decoration:line-through;font-variant-numeric:tabular-nums}
.pdp__savings-tag{background:#FFDBD0;color:#D43F00;padding:4px 8px;border-radius:4px;font-size:12px;font-weight:700}

.pdp__form{display:flex;flex-direction:column;gap:14px;margin:4px 0}
.pdp__variant-label{font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--c-muted)}
.pdp__variant-select{appearance:none;-webkit-appearance:none;background:var(--c-surface);border:1px solid var(--c-border);border-radius:var(--r-md);padding:14px 40px 14px 16px;font-family:var(--f-body);font-size:15px;color:var(--c-text);cursor:pointer;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8' fill='none'><path d='M1 1l5 5 5-5' stroke='%231A1C1C' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/></svg>");background-repeat:no-repeat;background-position:right 16px center}
.pdp__variant-select:focus{outline:2px solid var(--c-accent);outline-offset:2px;border-color:var(--c-accent)}

.pdp__atc{background-color:var(--c-accent)!important;color:#fff!important;border-color:var(--c-accent)!important;text-transform:uppercase;letter-spacing:1px;font-weight:700;padding:18px;font-size:16px;border-radius:8px}
.pdp__atc:hover{background-color:#D43F00!important}

.pdp__social-proof{background:#ffffff;border:1px solid var(--c-border);padding:12px 16px;border-radius:30px;display:flex;align-items:center;gap:12px;box-shadow:0 4px 16px rgba(0,0,0,0.06);margin-top:8px;animation:slideUp .3s ease}
.pdp__sp-avatar{width:32px;height:32px;border-radius:50%;background:#FFDAD6;color:#93000A;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;flex-shrink:0}
.pdp__sp-text{font-size:13px;line-height:1.3;color:var(--c-text)}
.pdp__sp-time{font-size:11px;color:var(--c-muted);margin-top:2px}
.pdp__sp-close{background:none;border:none;font-size:18px;color:var(--c-muted);cursor:pointer;margin-left:auto;padding:0 4px}
.pdp__sp-close:hover{color:var(--c-text)}
@keyframes slideUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

.pdp__desc{font-size:15px;line-height:1.65;color:var(--c-text);margin-top:8px}
.pdp__desc > *:last-child{margin-bottom:0}
.pdp__desc h2, .pdp__desc h3{color:var(--c-text)}

.pdp__apps{margin-top:56px}
.pdp__app-slot + .pdp__app-slot{margin-top:32px}

<script>
(function(){
  var root = document.getElementById('pdp-{{ section.id }}');
  if(!root) return;
  var thumbs = root.querySelectorAll('[data-thumb]');
  var slides = root.querySelectorAll('[data-slide]');
  thumbs.forEach(function(btn){
    btn.addEventListener('click', function(){
      var idx = btn.getAttribute('data-thumb');
      slides.forEach(function(s){ s.classList.toggle('is-active', s.getAttribute('data-slide') === idx); });
      thumbs.forEach(function(t){ t.classList.toggle('is-active', t === btn); });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product page",
  "settings": [],
  "blocks": [
    {"type": "@app"}
  ],
  "enabled_on": {"templates": ["product"]}
}
{% endschema %}
