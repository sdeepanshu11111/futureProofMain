<section class="pdp-gallery" id="pdp-gallery-{{ section.id }}">
  <div class="pw">
    <div class="sh">
      <h2 class="sh__title" style="color: #FFF;">Real People. Real Results.</h2>
      <p class="sh__text" style="color: #E5E2E1;">See how our community is transforming their skin.</p>
    </div>

    <div class="gallery-grid">
      {%- for i in (1..4) -%}
        <div class="gallery-item">
          {{ 'lifestyle-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
          <div class="gallery-overlay">
            <div class="gallery-stars">★★★★★</div>
            <p>"Absolute game changer."</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
.pdp-gallery { background-color: #0D0D0D; padding: 60px 0; border-top: 1px solid #1A1A1A; }
.gallery-grid { display: flex; overflow-x: auto; gap: 12px; scroll-snap-type: x mandatory; padding-bottom: 12px; -ms-overflow-style: none; scrollbar-width: none; }
.gallery-grid::-webkit-scrollbar { display: none; }
.gallery-item { position: relative; aspect-ratio: 1; border-radius: var(--r-lg); overflow: hidden; background: #1A1A1A; border: 1px solid #333; scroll-snap-align: start; min-width: 240px; flex: 0 0 auto; }
@media(min-width: 768px) { .gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); overflow-x: visible; } .gallery-item { min-width: 0; } }
.gallery-item svg { width: 100%; height: 100%; object-fit: cover; }
.gallery-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.8), transparent 50%); display: flex; flex-direction: column; justify-content: flex-end; padding: 16px; opacity: 0; transition: opacity 0.3s ease; }
.gallery-item:hover .gallery-overlay { opacity: 1; }
.gallery-stars { color: #D4A843; font-size: 14px; margin-bottom: 4px; }
.gallery-overlay p { color: #FFF; font-size: 13px; font-weight: 500; margin: 0; }
</style>

{% schema %}
{
  "name": "Customer Gallery",
  "settings": [],
  "presets": [{"name": "Customer Gallery"}]
}
{% endschema %}
