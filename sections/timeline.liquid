<div class="tml section" style="background:{{ section.settings.bg_color | default: '#FFFFFF' }}">
  <div class="pw">
    {%- if section.settings.eyebrow != blank -%}<p class="tml__eye">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="tml__hd">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subtext != blank -%}<p class="tml__sub">{{ section.settings.subtext }}</p>{%- endif -%}

    <ol class="tml__list">
      {%- for block in section.blocks -%}
        <li class="tml__item" {{ block.shopify_attributes }}>
          <div class="tml__num">{{ forloop.index }}</div>
          {%- if block.settings.duration != blank -%}<p class="tml__dur">{{ block.settings.duration }}</p>{%- endif -%}
          <h3 class="tml__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="tml__text">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

<style>
.tml{padding:48px 0}
@media(min-width:768px){.tml{padding:80px 0}}
.tml__eye{font-family:var(--f-body);font-size:13px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--c-highlight);margin:0 0 12px;text-align:center}
.tml__hd{font-family:var(--f-display);font-size:clamp(26px,4vw,42px);font-weight:700;line-height:1.15;letter-spacing:-.02em;text-align:center;margin:0 auto 14px;max-width:820px;color:var(--c-text)}
.tml__sub{font-size:15px;color:var(--c-muted);text-align:center;max-width:600px;margin:0 auto 36px;line-height:1.55}
@media(min-width:768px){.tml__sub{margin-bottom:56px}}

.tml__list{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr;gap:24px;counter-reset:none}
@media(min-width:768px){.tml__list{grid-template-columns:repeat(3,1fr);gap:24px;position:relative}}
@media(min-width:768px){.tml__list::before{content:'';position:absolute;top:24px;left:12%;right:12%;height:2px;background:var(--c-border);z-index:0}}

.tml__item{position:relative;background:var(--c-surface);border:1px solid var(--c-border);border-radius:12px;padding:28px 24px 26px;text-align:left;z-index:1}
.tml__num{position:absolute;top:-22px;left:24px;width:48px;height:48px;border-radius:50%;background:var(--c-highlight);color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--f-display);font-weight:700;font-size:20px;line-height:1;border:4px solid {{ section.settings.bg_color | default: '#FFFFFF' }};box-shadow:0 4px 12px rgba(0,0,0,.08)}
.tml__dur{font-family:var(--f-body);font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--c-highlight);margin:14px 0 8px}
.tml__title{font-family:var(--f-display);font-size:20px;font-weight:700;line-height:1.25;letter-spacing:-.01em;margin:0 0 10px;color:var(--c-text)}
.tml__text{font-size:14px;color:var(--c-muted);line-height:1.55;margin:0}
</style>

{% schema %}
{"name":"Timeline","settings":[
  {"type":"color","id":"bg_color","label":"Background","default":"#FFFFFF"},
  {"type":"text","id":"eyebrow","label":"Eyebrow"},
  {"type":"text","id":"heading","label":"Heading","default":"How our patches work over time"},
  {"type":"textarea","id":"subtext","label":"Subtext"}
],"blocks":[{"type":"step","name":"Step","limit":6,"settings":[
  {"type":"text","id":"duration","label":"Duration","default":"1+ Months"},
  {"type":"text","id":"title","label":"Title","default":"Noticeable hunger control"},
  {"type":"textarea","id":"text","label":"Text","default":"Participants in a clinical study using Berberine reduced their food intake by 47.5%, helping them feel satisfied with less."}
]}],"presets":[{"name":"Timeline","blocks":[
  {"type":"step","settings":{"duration":"1+ Months","title":"Noticeable hunger control","text":"Participants in a clinical study using Berberine reduced their food intake by 47.5%, helping them feel satisfied with less."}},
  {"type":"step","settings":{"duration":"2+ Months","title":"Better glucose & appetite balance","text":"Berberine, glutamine, and chromium support the L-cells in your gut, encouraging healthy hormone production that regulates blood sugar and curbs cravings."}},
  {"type":"step","settings":{"duration":"3+ Months","title":"Visible weight loss results","text":"Customers report reduced body weight, visceral fat, and a slimmer hip and waist circumference."}}
]}]}
{% endschema %}
