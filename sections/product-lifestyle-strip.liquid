{%- liquid
  assign bg = section.settings.bg_color | default: '#FFFFFF'
  comment
    Per-product content from metafields:
      custom.lifestyle_heading (single-line text) — overrides the heading
      custom.lifestyle_images (list of file references) — replaces section image blocks
    If on a product page and the images metafield is empty, the strip is hidden.
    On non-product pages (or if both metafields are empty), section blocks render.
  endcomment
  assign mf_heading = product.metafields.custom.lifestyle_heading
  assign mf_images = product.metafields.custom.lifestyle_images.value
  assign use_mf_images = false
  if mf_images != blank and mf_images.size > 0
    assign use_mf_images = true
  endif

  assign render_heading = ''
  if mf_heading != blank
    assign render_heading = mf_heading
  endif

  assign should_render = true
  if product != blank and use_mf_images == false
    assign should_render = false
  endif
-%}

{%- if should_render -%}
<section class="pls" id="pls-{{ section.id }}" style="background:{{ bg }}">
  <div class="pw">
    {%- if render_heading != blank -%}
      <h2 class="pls__heading">{{ render_heading }}</h2>
    {%- endif -%}

    <div class="pls__grid" data-pls-track>
      {%- if use_mf_images -%}
        {%- for img in mf_images -%}
          <div class="pls__item">
            <img src="{{ img | image_url: width: 800 }}" alt="{{ img.alt | escape }}" width="800" height="880" loading="lazy">
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <div class="pls__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.image.alt | escape }}" width="{{ block.settings.image.width | default: 800 }}" height="{{ block.settings.image.height | default: 880 }}" loading="lazy">
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'pls__placeholder' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- assign dot_count = section.blocks.size -%}
    {%- if use_mf_images -%}{%- assign dot_count = mf_images.size -%}{%- endif -%}
    {%- if dot_count > 1 -%}
      <div class="pls__dots" data-pls-dots>
        {%- for i in (1..dot_count) -%}
          <span class="pls__dot{% if forloop.first %} is-active{% endif %}" data-pls-dot="{{ forloop.index0 }}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

<style>
.pls{padding:24px 0 22px}
@media(min-width:768px){.pls{padding:56px 0 40px}}
.pls__heading{text-align:center;font-family:var(--f-display);font-size:clamp(20px,2.6vw,30px);font-weight:700;letter-spacing:-.015em;margin:0 16px 16px;color:#111}
@media(min-width:768px){.pls__heading{margin:0 0 28px}}
.pls__grid{display:flex;gap:6px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 12px 6px;-ms-overflow-style:none;scrollbar-width:none}
.pls__grid::-webkit-scrollbar{display:none}
.pls__item{flex:0 0 70%;aspect-ratio:1/1.1;overflow:hidden;background:#F3F4F6;border-radius:8px;scroll-snap-align:start}
@media(min-width:768px){.pls__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:0}.pls__item{flex:initial}}
.pls__item img,.pls__item svg{width:100%;height:100%;object-fit:cover;display:block}
.pls__dots{display:flex;justify-content:center;gap:6px;margin-top:14px}
@media(min-width:768px){.pls__dots{display:none}}
.pls__dot{width:7px;height:7px;border-radius:50%;background:#D1D5DB;transition:background .2s}
.pls__dot.is-active{background:#111}
</style>

<script>
(function(){
  var root = document.getElementById('pls-{{ section.id }}');
  if(!root) return;
  var track = root.querySelector('[data-pls-track]');
  var dots = root.querySelectorAll('[data-pls-dot]');
  if(!track || !dots.length) return;
  track.addEventListener('scroll', function(){
    var items = track.children;
    if(!items.length) return;
    var w = items[0].getBoundingClientRect().width + 8;
    var idx = Math.round(track.scrollLeft / w);
    dots.forEach(function(d, i){ d.classList.toggle('is-active', i === idx); });
  }, {passive:true});
  dots.forEach(function(d){
    d.addEventListener('click', function(){
      var idx = parseInt(d.getAttribute('data-pls-dot'),10);
      var items = track.children;
      if(!items[idx]) return;
      var w = items[0].getBoundingClientRect().width + 8;
      track.scrollTo({left: idx * w, behavior: 'smooth'});
    });
  });
})();
</script>

{% schema %}
{
  "name": "Lifestyle strip",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Wear. Protect. Glow."},
    {"type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF"}
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 8,
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Image"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Lifestyle strip",
      "blocks": [
        {"type": "image"},
        {"type": "image"},
        {"type": "image"},
        {"type": "image"}
      ]
    }
  ]
}
{% endschema %}
