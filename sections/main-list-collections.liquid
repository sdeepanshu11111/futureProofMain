<div class="section">
  <div class="pw">
    <div class="sh">
      <p class="sh__eye">EXPLORE</p>
      <h1 class="sh__title">{{ page_title | default: 'Collections' }}</h1>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px">
      {%- for collection in collections -%}
      <a href="{{ collection.url }}" style="position:relative;display:block;aspect-ratio:4/5;border-radius:var(--r-lg);overflow:hidden;color:#fff;background:var(--c-surface-2)">
        {%- if collection.image -%}<img src="{{ collection.image | image_url: width: 800 }}" alt="{{ collection.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover">{%- elsif collection.products.first.featured_image -%}<img src="{{ collection.products.first.featured_image | image_url: width: 800 }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover">{%- else -%}<div style="width:100%;height:100%;background:linear-gradient(135deg,var(--c-highlight),var(--c-accent))"></div>{%- endif -%}
<div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(31,22,20,.7),transparent 60%);display:flex;flex-direction:column;justify-content:flex-end;padding:28px">
<h3 style="font-family:var(--f-display);font-size:24px;margin:0 0 6px;color:#fff;font-weight:500">{{ collection.title }}</h3>
<span style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.08em">Shop now →</span>
</div></a>
{%- endfor -%}
</div></div></div>
{% schema %}{"name":"List collections","settings":[],"enabled_on":{"templates":["list-collections"]}}{% endschema %}
