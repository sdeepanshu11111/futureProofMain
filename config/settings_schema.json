  {
    "name": "Conversion & retention",
    "settings": [
      {
        "type": "paragraph",
        "content": "Tools that win back hesitant shoppers \u2014 exit-intent popups, abandonment retention, and pre-checkout offers. Use sparingly: Indian shoppers can spot a desperate brand."
      },
      {
        "type": "header",
        "content": "Welcome offer (first-time visitors)"
      },
      {
        "type": "checkbox",
        "id": "welcome_popup_enable",
        "label": "Show welcome popup to first-time visitors",
        "default": true
      },
      {
        "type": "text",
        "id": "welcome_popup_eyebrow",
        "label": "Eyebrow",
        "default": "WELCOME, BEAUTIFUL"
      },
      {
        "type": "text",
        "id": "welcome_popup_heading",
        "label": "Heading",
        "default": "10% off your first order"
      },
      {
        "type": "text",
        "id": "welcome_popup_subheading",
        "label": "Subheading",
        "default": "Plus skincare tips delivered to your inbox. No spam \u2014 pinky promise."
      },
      {
        "type": "text",
        "id": "welcome_popup_code",
        "label": "Discount code (must exist in Shopify Discounts)",
        "default": "WELCOME10",
        "info": "Create a matching discount in Discounts admin."
      },
      {
        "type": "text",
        "id": "welcome_popup_button",
        "label": "Button text",
        "default": "Reveal my code"
      },
      {
        "type": "range",
        "id": "welcome_popup_delay",
        "label": "Show after (seconds)",
        "min": 3,
        "max": 30,
        "step": 1,
        "default": 8,
        "unit": "s"
      },
      {
        "type": "image_picker",
        "id": "welcome_popup_image",
        "label": "Popup image (optional)"
      },
      {
        "type": "header",
        "content": "Exit-intent popup"
      },
      {
        "type": "paragraph",
        "content": "Triggers when a desktop visitor moves to close the tab, or a mobile visitor presses back. Shown at most once per session."
      },
      {
        "type": "checkbox",
        "id": "exit_intent_enable",
        "label": "Enable exit-intent popup",
        "default": true
      },
      {
        "type": "text",
        "id": "exit_intent_heading",
        "label": "Heading",
        "default": "Wait \u2014 don't leave empty-handed"
      },
      {
        "type": "text",
        "id": "exit_intent_subheading",
        "label": "Subheading",
        "default": "Take 15% off if you order in the next 10 minutes."
      },
      {
        "type": "text",
        "id": "exit_intent_code",
        "label": "Discount code",
        "default": "DONTGO15"
      },
      {
        "type": "text",
        "id": "exit_intent_button",
        "label": "Button text",
        "default": "Claim my discount"
      },
      {
        "type": "header",
        "content": "Tab-away retention"
      },
      {
        "type": "paragraph",
        "content": "When the visitor switches to another tab, the page title flickers to lure them back. Only fires when they have items in cart."
      },
      {
        "type": "checkbox",
        "id": "tab_away_enable",
        "label": "Enable tab-away title alert",
        "default": true
      },
      {
        "type": "text",
        "id": "tab_away_message_1",
        "label": "Title alert 1",
        "default": "\ud83d\udc40 Your cart is waiting\u2026"
      },
      {
        "type": "text",
        "id": "tab_away_message_2",
        "label": "Title alert 2",
        "default": "\ud83d\udc96 Don't lose your items!"
      },
      {
        "type": "header",
        "content": "Pre-checkout retention"
      },
      {
        "type": "paragraph",
        "content": "Last-mile interception when the visitor clicks Checkout. One final reason to complete the order. Shown once per session."
      },
      {
        "type": "checkbox",
        "id": "precheckout_enable",
        "label": "Show pre-checkout retention",
        "default": true
      },
      {
        "type": "text",
        "id": "precheckout_eyebrow",
        "label": "Eyebrow",
        "default": "ONE LAST THING"
      },
      {
        "type": "text",
        "id": "precheckout_heading",
        "label": "Heading",
        "default": "Use code SAVE5 for \u20b950 off"
      },
      {
        "type": "text",
        "id": "precheckout_subheading",
        "label": "Subheading",
        "default": "Apply this code at checkout. Limited to your first order."
      },
      {
        "type": "text",
        "id": "precheckout_code",
        "label": "Discount code",
        "default": "SAVE5"
      },
      {
        "type": "text",
        "id": "precheckout_button",
        "label": "Button text",
        "default": "Continue to checkout"
      },
      {
        "type": "header",
        "content": "Inactivity reminder"
      },
      {
        "type": "paragraph",
        "content": "Floating reminder shown when the shopper has been idle on a page for a while with items in cart."
      },
      {
        "type": "checkbox",
        "id": "idle_reminder_enable",
        "label": "Show inactivity reminder",
        "default": true
      },
      {
        "type": "range",
        "id": "idle_reminder_seconds",
        "label": "Show after idle (seconds)",
        "min": 30,
        "max": 180,
        "step": 15,
        "default": 60,
        "unit": "s"
      },
      {
        "type": "text",
        "id": "idle_reminder_text",
        "label": "Reminder text",
        "default": "You have items waiting in your cart"
      }
    ]
  },
